                  "col": 45,
                  "tokLen": 1
                }
              },
              "text": " Updates the object's (bl) name on client."
            },
            {
              "id": "0x555561287c40",
              "kind": "TextComment",
              "loc": {
                "offset": 304008,
                "line": 9923,
                "col": 4,
                "tokLen": 0
              },
              "range": {
                "begin": {
                  "offset": 304008,
                  "col": 4,
                  "tokLen": 0
                },
                "end": {
                  "offset": 304066,
                  "col": 62,
                  "tokLen": 1
                }
              },
              "text": " Used to update when a char leaves a party/guild. [Skotlex]"
            },
            {
              "id": "0x555561287c60",
              "kind": "TextComment",
              "loc": {
                "offset": 304071,
                "line": 9924,
                "col": 4,
                "tokLen": 0
              },
              "range": {
                "begin": {
                  "offset": 304071,
                  "col": 4,
                  "tokLen": 0
                },
                "end": {
                  "offset": 304187,
                  "col": 120,
                  "tokLen": 1
                }
              },
              "text": " Needed because when you send a 0x95 packet, the client will not remove the cached party/guild info that is not sent."
            },
            {
              "id": "0x555561287c80",
              "kind": "TextComment",
              "loc": {
