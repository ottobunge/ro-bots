 switch(type) {

 case ALL_CLIENT:
  iter = mapit_alloc(MAPIT_NORMAL,BL_PC);
  while( ( tsd = static_cast<const map_session_data*>(mapit_next( iter )) ) != nullptr ){
   if( session_isActive( fd = tsd->fd ) ){
    do{ if( ( fd ) && session[( fd )]->wdata_size + ( len ) > session[( fd )]->max_wdata ){ _realloc_writefifo( ( fd ), ( len ), "/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/src/map/clif.cpp", 497, __FUNCTION__ ); } }while( false );
