 if (!g)
  return;

 fd = sd->fd;
 do{ if( ( fd ) && session[( fd )]->wdata_size + ( 20 * 28 + 4 ) > session[( fd )]->max_wdata ){ _realloc_writefifo( ( fd ), ( 20 * 28 + 4 ), "/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/src/map/clif.cpp", 8922, __FUNCTION__ ); } }while( false );
