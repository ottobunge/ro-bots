void clif_parse_NoviceExplosionSpirits(int32 fd, map_session_data *sd)
{
 if( (sd->class_&0xfff) == MAPID_SUPER_NOVICE ) {
  t_exp next = pc_nextbaseexp(sd);

  if( next ) {
   int32 percent = (int32)( ( (double)sd->status.base_exp/(double)next )*1000. );

   if( percent && ( percent%100 ) == 0 ) {
    sc_start(sd,sd, SC_EXPLOSIONSPIRITS, 100, 17, skill_get_time(MO_EXPLOSIONSPIRITS, 5));
    clif_skill_nodamage(sd, *sd, MO_EXPLOSIONSPIRITS, 5);
   }
  }
 }
}
