{
 int32 item_index, item_amount;

 struct s_packet_db* info = &packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))];

 item_index = (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[0])))-1;
 item_amount = (*(uint32*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[1])));

 if (sd->state.storage_flag == 1)
  storage_storageget(sd, &sd->storage, item_index, item_amount);
 else if(sd->state.storage_flag == 2)
  storage_guild_storageget(sd, item_index, item_amount);
 else if(sd->state.storage_flag == 3)
  storage_storageget(sd, &sd->premiumStorage, item_index, item_amount);
}




