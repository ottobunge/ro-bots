 n = (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))].pos[0])))-2;

 if(n <0 || n >= ( 100 + 0 ))
