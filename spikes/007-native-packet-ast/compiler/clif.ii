void clif_parse_ActionRequest_sub( map_session_data& sd, uint8 action_type, int32 target_id, t_tick tick ){
 if (( (&sd)->state.dead_sit == 1 )) {
  clif_clearunit_area(sd, CLR_DEAD);
  return;
 }


 if (action_type != DMG_NORMAL && action_type != DMG_REPEAT) {
  if (sd.sc.cant.interact)
   return;

  unit_stop_walking( &sd, USW_FIXPOS );
 }

 unit_stop_attack( &sd );

 if(target_id<0 && -target_id == sd.id)
  target_id = sd.id;

 switch(action_type)
 {
 case DMG_NORMAL:
 case DMG_REPEAT:

  if( pc_cant_act(&sd) )
   return;

  if (!battle_config.sdelay_attack_enable && pc_checkskill(&sd, SA_FREECAST) <= 0) {
   if (tick_diff(tick,sd.ud.canact_tick) < 0) {
    clif_skill_fail( sd, 1, USESKILL_FAIL_SKILLINTERVAL );
    return;
   }
  }

  pc_delinvincibletimer(&sd);
  if (battle_config.idletime_option&IDLE_ATTACK)
   sd.idletime = last_tick;
  if (battle_config.hom_idle_no_share && sd.hd && battle_config.idletime_hom_option&IDLE_ATTACK)
   sd.idletime_hom = last_tick;
  if (battle_config.mer_idle_no_share && sd.md && battle_config.idletime_mer_option&IDLE_ATTACK)
   sd.idletime_mer = last_tick;
  unit_attack(&sd, target_id, action_type != 0);
  break;
 case DMG_SIT_DOWN:
  if (battle_config.basic_skill_check && pc_checkskill(&sd, NV_BASIC) < 3 && pc_checkskill(&sd, SU_BASIC_SKILL) < 1) {
   clif_skill_fail( sd, 1, USESKILL_FAIL_LEVEL, 2 );
   break;
  }

  if(( (&sd)->vd.dead_sit == 2 )) {

   clif_sitting(sd);
   return;
  }

  if (sd.ud.skilltimer != -1 || (sd.sc.opt1 && sd.sc.opt1 != OPT1_STONEWAIT && sd.sc.opt1 != OPT1_BURNING))
   break;

  if (!sd.sc.empty() && (
   sd.sc.getSCE(SC_DANCING) ||
   (sd.sc.getSCE(SC_GRAVITATION) && sd.sc.getSCE(SC_GRAVITATION)->val3 == BCT_SELF)
  ))
   break;

  if (sd.state.block_action & PCBLOCK_SITSTAND) {
   clif_displaymessage(sd.fd, map_msg_txt(&sd,794));
   break;
  }

  if (battle_config.idletime_option&IDLE_SIT)
   sd.idletime = last_tick;
  if (battle_config.hom_idle_no_share && sd.hd && battle_config.idletime_hom_option&IDLE_SIT)
   sd.idletime_hom = last_tick;
  if (battle_config.mer_idle_no_share && sd.md && battle_config.idletime_mer_option&IDLE_SIT)
   sd.idletime_mer = last_tick;

  { unit_stop_walking( (&sd), USW_FIXPOS|USW_MOVE_FULL_CELL ); unit_stop_attack( (&sd) ); (&sd)->state.dead_sit = (&sd)->vd.dead_sit = 2; };
  skill_sit(&sd, true);
  clif_sitting(sd);
  break;
 case DMG_STAND_UP:
  if (!( (&sd)->vd.dead_sit == 2 )) {

   clif_standing(sd);
   return;
  }

  if (sd.sc.opt1 && sd.sc.opt1 != OPT1_STONEWAIT && sd.sc.opt1 != OPT1_BURNING)
   break;

  if (sd.state.block_action & PCBLOCK_SITSTAND) {
   clif_displaymessage(sd.fd, map_msg_txt(&sd,794));
   break;
  }

  if (pc_setstand(&sd, false)) {
   if (battle_config.idletime_option&IDLE_SIT)
    sd.idletime = last_tick;
   if (battle_config.hom_idle_no_share && sd.hd && battle_config.idletime_hom_option&IDLE_SIT)
    sd.idletime_hom = last_tick;
   if (battle_config.mer_idle_no_share && sd.md && battle_config.idletime_mer_option&IDLE_SIT)
    sd.idletime_mer = last_tick;
   skill_sit(&sd, false);
   clif_standing(sd);
  }
  break;
 }
}
