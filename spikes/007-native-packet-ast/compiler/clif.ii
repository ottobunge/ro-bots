 }

 const PACKET_CZ_ADD_EXCHANGE_ITEM* p = reinterpret_cast<PACKET_CZ_ADD_EXCHANGE_ITEM*>( (session[fd]->rdata + session[fd]->rdata_pos + (0)) );

 if( p->index == 0 ){
  trade_tradeaddzeny( sd, p->amount );
 }else{
  trade_tradeadditem( sd, server_index( p->index ), static_cast<int16>( p->amount ) );
 }
