void clif_parse_LoadEndAck(int32 fd,map_session_data *sd)
{
 bool guild_notice = false;

 if(sd->prev != nullptr)
  return;


 if (!sd->state.active || (!sd->state.autotrade && !sd->state.pc_loaded)) {

  sd->state.connect_new = 0;
  return;
 }

 if (sd->state.rewarp) {
  sd->state.rewarp = 0;
  clif_changemap( *sd, sd->m, sd->x, sd->y );
  return;
 }

 sd->state.warping = 0;






 clif_changelook(sd,LOOK_WEAPON,0);

 pc_set_costume_view(sd);

 clif_refresh_clothcolor( *sd, SELF );


 clif_inventorylist(sd);
 pc_checkitem(sd);
 clif_equipswitch_list(sd);


 if(( (sd)->sc.getSCE(SC_PUSH_CART) )) {
  clif_cartlist(sd);
  clif_updatestatus(*sd,SP_CARTINFO);
 }


 clif_updatestatus(*sd,SP_WEIGHT);
 clif_updatestatus(*sd,SP_MAXWEIGHT);



 if(sd->status.guild_id)
  guild_send_memberinfoshort(sd,1);

 struct map_data *mapdata = map_getmapdata(sd->m);

 pc_setinvincibletimer( *sd );

 if( mapdata->users++ == 0 && battle_config.dynamic_mobs )
  map_spawnmobs(sd->m);
 if( !( (sd)->sc.option&OPTION_INVISIBLE ) ) {
  mapdata->users_pvp++;
 }
 sd->state.debug_remove_map = 0;


 sd->state.callshop = 0;

 if(map_addblock(sd))
  return;
 clif_spawn(sd);



 if(sd->status.party_id) {
  party_send_movemap(sd);
  clif_party_hp( *sd );
 }

 if( sd->bg_id ) clif_bg_hp(sd);

 if(!( (sd)->sc.option&OPTION_INVISIBLE ) && mapdata->getMapFlag(MF_PVP)) {
  if(!battle_config.pk_mode) {
   if (!mapdata->getMapFlag(MF_PVP_NOCALCRANK))
    sd->pvp_timer = add_timer(gettick()+200, pc_calc_pvprank_timer, sd->id, 0);
   sd->pvp_rank = 0;
   sd->pvp_lastusers = 0;
   sd->pvp_point = 5;
   sd->pvp_won = 0;
   sd->pvp_lost = 0;
  }
  clif_map_property(sd, MAPPROPERTY_FREEPVPZONE, SELF);
 } else if(sd->duel_group)
  clif_map_property(sd, MAPPROPERTY_FREEPVPZONE, SELF);
 else if (mapdata->getMapFlag(MF_GVG_DUNGEON))
  clif_map_property(sd, MAPPROPERTY_FREEPVPZONE, SELF);
 else if( mapdata_flag_gvg(mapdata) )
  clif_map_property(sd, MAPPROPERTY_AGITZONE, SELF);
 else
  clif_map_property(sd, MAPPROPERTY_NOTHING, SELF);



 map_foreachinallarea(clif_getareachar, sd->m, sd->x-battle_config.area_size, sd->y-battle_config.area_size, sd->x+battle_config.area_size, sd->y+battle_config.area_size, BL_ALL, sd);


 if( sd->pd ) {
  if( battle_config.pet_no_gvg && mapdata_flag_gvg(mapdata) ) {
   clif_displaymessage(sd->fd, map_msg_txt(sd,666));
   pet_return_egg( sd, sd->pd );
  } else {
   if(map_addblock(sd->pd))
    return;
   clif_spawn(sd->pd);
   clif_send_petdata( sd, *sd->pd, CHANGESTATEPET_INIT );
   clif_send_petstatus( *sd, *sd->pd );

  }
 }


 if( ((sd->hd) && (sd->hd)->homunculus.vaporize == HOM_ST_ACTIVE && (sd->hd)->battle_status.hp > 0) ) {
  if(map_addblock(sd->hd))
   return;
  clif_spawn(sd->hd);
  clif_send_homdata( *sd->hd, SP_ACK );

  clif_hominfo(sd, sd->hd, 1);
  clif_hominfo(sd, sd->hd, 0);
  clif_homunculus_updatestatus(*sd, SP_HP);
  clif_homunculus_updatestatus(*sd, SP_SP);
  clif_homskillinfoblock( *sd->hd );
  status_calc_bl(sd->hd, { SCB_SPEED });
  if( !(battle_config.hom_setting&HOMSET_NO_INSTANT_LAND_SKILL) )
   skill_unit_move(sd->hd,gettick(),1);
 }

 if( sd->md ) {
  if(map_addblock(sd->md))
   return;
  clif_spawn(sd->md);
  clif_mercenary_info(sd);
  clif_mercenary_skillblock(sd);
  status_calc_bl(sd->md, { SCB_SPEED });
 }

 if( sd->ed ) {
  if (map_addblock(sd->ed))
   return;
  clif_spawn(sd->ed);
  clif_elemental_info(sd);
  clif_elemental_updatestatus(*sd, SP_HP);
  clif_hpmeter_single( *sd, sd->ed->id, sd->ed->battle_status.hp, sd->ed->battle_status.max_hp );
  clif_elemental_updatestatus(*sd, SP_SP);
  status_calc_bl(sd->ed, { SCB_SPEED });
 }

 if(sd->state.connect_new) {
  int32 lv;
  guild_notice = true;
  clif_skillinfoblock(*sd);
  clif_hotkeys_send(sd,0);



  clif_updatestatus(*sd,SP_BASEEXP);
  clif_updatestatus(*sd,SP_NEXTBASEEXP);
  clif_updatestatus(*sd,SP_JOBEXP);
  clif_updatestatus(*sd,SP_NEXTJOBEXP);
  clif_updatestatus(*sd,SP_SKILLPOINT);
  clif_initialstatus( *sd );

  if (sd->sc.option&OPTION_FALCON)
   clif_status_change((sd), (EFST_FALCON), (1), 0, 0, 0, 0);
  else if (sd->sc.option&(OPTION_RIDING|OPTION_DRAGON))
   clif_status_change((sd), (EFST_RIDING), (1), 0, 0, 0, 0);
  else if (sd->sc.option&OPTION_WUGRIDER)
   clif_status_change((sd), (EFST_WUGRIDER), (1), 0, 0, 0, 0);
  else if (sd->sc.getSCE(SC_ALL_RIDING))
