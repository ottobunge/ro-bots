void clif_parse_PartyChangeOption(int32 fd, map_session_data *sd)
{
 struct party_data *p;
 int32 i,expflag;
 int32 cmd = (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)));
 struct s_packet_db* info = &packet_db[cmd];

 if( !sd->status.party_id )
  return;

 p = party_search(sd->status.party_id);
 if( p == nullptr )
  return;
 do{ for( (i) = (0); (i) < (12); ++(i) ) if( p->data[i].sd == sd ) break; }while(0);
 if( i == 12 )
  return;
 if( !p->party.member[i].leader )
  return;

 expflag = (*(uint32*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[0])));
 if(cmd == 0x0102){
  party_changeoption(sd, expflag, p->party.item);
 }
 else {
  int32 itemflag = ((*(uint8*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[1])))?1:0)|((*(uint8*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[2])))?2:0);
  party_changeoption(sd, expflag, itemflag);
 }
}




