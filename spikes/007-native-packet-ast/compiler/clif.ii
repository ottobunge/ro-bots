   clif_send(buf,packet_db[0x19a].len,sd,SELF);
  else if(!type)
   clif_send(buf,packet_db[0x19a].len,sd,AREA);
  else
   clif_send(buf,packet_db[0x19a].len,sd,ALL_SAMEMAP);
 }
}





