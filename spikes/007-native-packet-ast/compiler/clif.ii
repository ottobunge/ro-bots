void clif_parse_RemoveOption(int32 fd,map_session_data *sd)
{
 if( !(sd->sc.option&(OPTION_RIDING|OPTION_FALCON|OPTION_DRAGON|OPTION_MADOGEAR))

  && sd->sc.getSCE(SC_PUSH_CART) )
  pc_setcart(sd,0);




 else
  pc_setoption(sd,sd->sc.option&~(OPTION_RIDING|OPTION_FALCON|OPTION_DRAGON|OPTION_MADOGEAR));
}




void clif_SelectCart( const map_session_data* sd ) {

 int32 i = 0, carts = 3;

 int32 fd = sd->fd;
 do{ if( ( fd ) && session[( fd )]->wdata_size + ( 8 + carts ) > session[( fd )]->max_wdata ){ _realloc_writefifo( ( fd ), ( 8 + carts ), "/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/src/map/clif.cpp", 12645, __FUNCTION__ ); } }while( false );
 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (0))) = 0x97f;
 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (2))) = 8 + carts;
 (*(uint32*)(session[fd]->wdata + session[fd]->wdata_size + (4))) = sd->status.account_id;

 for( i = 0; i < carts; i++ ) {
 (*(uint8*)(session[fd]->wdata + session[fd]->wdata_size + (8 + i))) = 10 + i;
 }
 WFIFOSET(fd,8 + carts);

}




void clif_parse_SelectCart(int32 fd,map_session_data *sd) {

 int32 type;


 if( !sd || pc_checkskill(sd,MC_CARTDECORATE) < 1 || (*(uint32*)(session[fd]->rdata + session[fd]->rdata_pos + (2))) != sd->status.account_id )
 return;

 type = (int32)(*(uint8*)(session[fd]->rdata + session[fd]->rdata_pos + (6)));


 if( type < 10 || type > 12 )
  return;

 pc_setcart(sd, type);

}




