static void clif_weather_check(map_session_data *sd)
{
 int16 m = sd->m;
 int32 fd = sd->fd;

 if (map_getmapflag_sub(m, MF_SNOW, nullptr)
  || map_getmapflag_sub(m, MF_CLOUDS, nullptr)
  || map_getmapflag_sub(m, MF_FOG, nullptr)
  || map_getmapflag_sub(m, MF_FIREWORKS, nullptr)
  || map_getmapflag_sub(m, MF_SAKURA, nullptr)
  || map_getmapflag_sub(m, MF_LEAVES, nullptr)
  || map_getmapflag_sub(m, MF_CLOUDS2, nullptr))
 {
  if (map_getmapflag_sub(m, MF_SNOW, nullptr))
   clif_specialeffect_single(sd, EF_SNOW, fd);
  if (map_getmapflag_sub(m, MF_CLOUDS, nullptr))
   clif_specialeffect_single(sd, EF_CLOUD3, fd);
  if (map_getmapflag_sub(m, MF_CLOUDS2, nullptr))
   clif_specialeffect_single(sd, EF_CLOUD5, fd);
  if (map_getmapflag_sub(m, MF_FOG, nullptr))
   clif_specialeffect_single(sd, EF_CLOUD4, fd);
  if (map_getmapflag_sub(m, MF_FIREWORKS, nullptr)) {
   clif_specialeffect_single(sd, EF_POKJUK, fd);
   clif_specialeffect_single(sd, EF_THROWITEM2, fd);
   clif_specialeffect_single(sd, EF_POKJUK_SOUND, fd);
  }
  if (map_getmapflag_sub(m, MF_SAKURA, nullptr))
   clif_specialeffect_single(sd, EF_SAKURA, fd);
  if (map_getmapflag_sub(m, MF_LEAVES, nullptr))
   clif_specialeffect_single(sd, EF_MAPLE, fd);
 }
}



void clif_weather(int16 m)
{
 struct s_mapiterator* iter;
 map_session_data *sd=nullptr;

 iter = mapit_alloc(MAPIT_NORMAL,BL_PC);
 for( sd = (map_session_data*)mapit_first(iter); mapit_exists(iter); sd = (map_session_data*)mapit_next(iter) )
 {
  if( sd->m == m )
   clif_weather_check(sd);
 }
 mapit_free(iter);
}






static inline bool clif_npc_mayapurple( const block_list& bl ){
 if( bl.type == BL_NPC ){
  const npc_data& nd = static_cast<const npc_data&>( bl );


  if( nd.is_invisible ){
   return true;
  }
 }

 return false;
}


