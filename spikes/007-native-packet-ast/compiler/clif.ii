void clif_party_option( const party_data *p, const map_session_data* sd, int32 flag)
{
 unsigned char buf[16];



 const int32 cmd = 0x7d8;


 (void)(p);

 if(!sd && flag==0){
  int32 i;
  do{ for( (i) = (0); (i) < (12); ++(i) ) if( p->data[i].sd ) break; }while(0);
  if (i < 12)
   sd = p->data[i].sd;
 }
 if(!sd) return;
 (*(uint16*)(((uint8*)((buf))) + ((0))))=cmd;
 (*(uint32*)(((uint8*)((buf))) + ((2))))=((flag&0x01)?2:p->party.exp);

 (*(uint8*)(((uint8*)((buf))) + ((6))))=(p->party.item&1)?1:0;
 (*(uint8*)(((uint8*)((buf))) + ((7))))=(p->party.item&2)?1:0;

 if(flag==0)
  clif_send(buf,packet_db[cmd].len,sd,PARTY);
 else
  clif_send(buf,packet_db[cmd].len,sd,SELF);
}
