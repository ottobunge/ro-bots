void clif_parse_progressbar(int32 fd, map_session_data * sd){

 if( !sd->progressbar.npc_id ){
  return;
 }

 int32 npc_id = sd->progressbar.npc_id;
 bool closing = false;


 if( gettick() < sd->progressbar.timeout && sd->st ){
  closing = true;
  sd->st->state = CLOSE;


  if( sd->st->mes_active ){
   clif_scriptclose( *sd, npc_id );
  }
 }

 sd->progressbar.npc_id = 0;
 sd->progressbar.timeout = 0;
 sd->state.workinprogress = WIP_DISABLE_NONE;

 if( battle_config.idletime_option&IDLE_NPC_PROGRESS ){
  sd->idletime = last_tick;
 }

 npc_scriptcont(sd, npc_id, closing);
}



void clif_progressbar_npc( const npc_data *nd, const map_session_data* sd ){

 unsigned char buf[14];

 if( nd->progressbar.timeout > 0 ){
  (*(uint16*)(((uint8*)((buf))) + ((0)))) = 0x9d1;
  (*(uint32*)(((uint8*)((buf))) + ((2)))) = nd->id;
  (*(uint32*)(((uint8*)((buf))) + ((6)))) = nd->progressbar.color;
  (*(uint32*)(((uint8*)((buf))) + ((10)))) = client_tick( ( nd->progressbar.timeout - gettick() ) / 1000 );

  if( sd ){
   clif_send(buf, packet_db[0x9d1].len, sd, SELF);
  }else{
   clif_send(buf, packet_db[0x9d1].len, nd, AREA);
  }
 }

}





void clif_parse_WalkToXY(int32 fd, map_session_data *sd)
{
