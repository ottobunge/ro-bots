# 8724 "/nix/store/9fnslka6gqn93qwrwzvj07i929fmhv68-source/src/map/clif.cpp"
void clif_guild_send_onlineinfo( const map_session_data* sd )
{
 unsigned char buf[14*128];
 int32 i, count=0, p_len;

 (void)(sd);

 p_len = packet_db[0x16d].len;

 auto &g = sd->guild;
 if (!g)
  return;

 for(i=0; i<g->guild.max_member; i++) {

  if(g->guild.member[i].account_id > 0 &&
   g->guild.member[i].account_id != sd->status.account_id) {

   (*(uint16*)(((uint8*)((buf))) + ((count*p_len)))) = 0x16d;
   (*(uint32*)(((uint8*)((buf))) + ((count*p_len+2)))) = g->guild.member[i].account_id;
   (*(uint32*)(((uint8*)((buf))) + ((count*p_len+6)))) = g->guild.member[i].char_id;
   (*(uint32*)(((uint8*)((buf))) + ((count*p_len+10)))) = g->guild.member[i].online;
   count++;
  }
 }

 clif_send(buf, p_len*count, sd, SELF);
}
