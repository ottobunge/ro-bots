 else if (sd->state.storage_flag == 2)
  storage_guild_storageaddfromcart( sd, idx, p->amount );
 else if (sd->state.storage_flag == 3)
  storage_storageaddfromcart( sd, &sd->premiumStorage, idx, p->amount );
}




