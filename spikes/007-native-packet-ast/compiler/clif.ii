{
 if (!( (sd)->state.dead_sit == 1 ))
  pc_memo(sd,-1);
}




void clif_parse_ProduceMix(int32 fd,map_session_data *sd){
 if( sd == nullptr ){
  return;
 }

 const PACKET_CZ_REQMAKINGITEM* p = reinterpret_cast<PACKET_CZ_REQMAKINGITEM*>( (session[fd]->rdata + session[fd]->rdata_pos + (0)) );

 switch( sd->menuskill_id ) {
  case -1:
  case AM_PHARMACY:
  case RK_RUNEMASTERY:
  case GC_RESEARCHNEWPOISON:
   break;
  default:
   return;
 }
 if (( (sd)->npc_id || (sd)->state.vending || (sd)->state.buyingstore || (sd)->state.trading )) {

  clif_skill_fail( *sd, sd->ud.skill_id );
  (sd)->menuskill_id = (sd)->menuskill_val = (sd)->menuskill_val2 = 0;;
  return;
 }

 int32 produce_idx;

 if( (produce_idx = skill_can_produce_mix(sd,p->itemId,sd->menuskill_val, 1)) )
  skill_produce_mix(sd,0,p->itemId,p->material[0],p->material[1],p->material[2],1,produce_idx-1);
 (sd)->menuskill_id = (sd)->menuskill_val = (sd)->menuskill_val2 = 0;;
}
