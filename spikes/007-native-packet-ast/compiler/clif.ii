void clif_parse_ActionRequest(int32 fd, map_session_data *sd)
{
 if( sd == nullptr ){
  return;
 }


 struct s_packet_db* info = &packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))];
 clif_parse_ActionRequest_sub( *sd,
  (*(uint8*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[1]))),
  (*(uint32*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[0]))),
  gettick()
 );
}







void clif_parse_Restart(int32 fd, map_session_data *sd)
{
 switch((*(uint8*)(session[fd]->rdata + session[fd]->rdata_pos + (packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))].pos[0])))) {
 case 0x00:
  pc_respawn(sd,CLR_OUTSIGHT);
  break;
 case 0x01:

  if( !sd->sc.getSCE(SC_CLOAKING) && !sd->sc.getSCE(SC_HIDING) && !sd->sc.getSCE(SC_CHASEWALK) && !sd->sc.getSCE(SC_CLOAKINGEXCEED) && !sd->sc.getSCE(SC_SUHIDE) && !sd->sc.getSCE(SC_NEWMOON) &&
   (!battle_config.prevent_logout || sd->canlog_tick == 0 || tick_diff(gettick(),sd->canlog_tick) > battle_config.prevent_logout) )
  {
   chrif_charselectreq(sd, session[fd]->client_addr);
  } else {
   clif_disconnect_ack(sd, 1);
  }
  break;
 }
}




void clif_parse_WisMessage(int32 fd, map_session_data* sd)
{
 map_session_data* dstsd;
 int32 i;
 char target[(23 + 1)], message[(255 + 1)], output[(255 + 1)+(23 + 1)*2];


 if( !clif_process_message( sd, true, target, message, output ) )
  return;


 log_chat(LOG_CHAT_WHISPER, 0, sd->status.char_id, sd->status.account_id, mapindex_idx2name((sd->mapindex), __FUNCTION__), sd->x, sd->y, target, message);




 if (target[0] && (strncasecmp(target,"NPC:",4) == 0) && (strlen(target) > 4))
 {
  char* str = target+4;
  npc_data* npc;
  if ((npc = npc_name2id(str))) {
   char split_data[10][(255 + 1)];
   char *split;
   char event[( 50 + 2 + (23 + 1) + 1 )];

   str = message;

   if( str[0] == '|' && strlen(str) >= 4 )
    str += 3;
   for( i = 0; i < 10; ++i ) {
    split = strchr(str,'#');
    if( split == nullptr ) {
     safestrncpy(split_data[i], str, ( sizeof(split_data[i])/sizeof((split_data[i])[0]) ));
     for( ++i; i < 10; ++i )
      split_data[i][0] = '\0';
     break;
    }
    *split = '\0';
    safestrncpy(split_data[i], str, ( sizeof(split_data[i])/sizeof((split_data[i])[0]) ));
    str = split+1;
   }

   for( i = 0; i < 10; ++i ) {
    char variablename[(255 + 1)];
    safesnprintf(variablename,sizeof(variablename),"@whispervar%d$", i);
    set_var_str( sd, variablename, split_data[i] );
   }

   safesnprintf(event,sizeof(event),"%s::%s", npc->exname,script_config.onwhisper_event_name);
   npc_event(sd,event,0);

   return;
  }
 } else if( target[0] == '#' ) {
  struct Channel *channel = nullptr;
  char* chname = target;

  channel = channel_name2channel(chname,sd,3);
  if(channel && (pc_has_permission(sd, PC_PERM_CHANNEL_ADMIN) || ((channel->opt&CHAN_OPT_CAN_CHAT) && channel_pccheckgroup(channel,sd->group_id)))){
   if(channel_pc_haschan(sd,channel)>=0){
    channel_send(channel,sd,message);
   }
   else if( channel->pass[0] == '\0') {
    if (channel_join(channel,sd)==0)
     channel_send(channel,sd,message);
   }
   else {
    clif_displaymessage(fd, map_msg_txt(sd,1402));
   }
   return;
  }
 }


 dstsd = map_nick2sd(target,false);

 if (dstsd == nullptr || strcmp(dstsd->status.name, target) != 0) {





  intif_wis_message(sd, target, message, strlen(message) + 1);
  return;
 }


 if (dstsd->state.ignoreAll && pc_get_group_level(sd) <= pc_get_group_level(dstsd)) {
  if (( (dstsd)->sc.option&OPTION_INVISIBLE ) && pc_get_group_level(sd) < pc_get_group_level(dstsd))
   clif_wis_end( *sd, ACKWHISPER_TARGET_OFFLINE );
  else
   clif_wis_end( *sd, ACKWHISPER_ALL_IGNORED );
  return;
 }


 if (dstsd->state.autotrade == 1){
  safesnprintf(output,sizeof(output),"%s is in autotrade mode and cannot receive whispered messages.", dstsd->status.name);
  clif_wis_message(sd, wisp_server_name, output, strlen(output) + 1, 0);
  return;
 }

 if (pc_get_group_level(sd) <= pc_get_group_level(dstsd)) {

  do{ for( (i) = (0); (i) < (20); ++(i) ) if( dstsd->ignore[i].name[0] == '\0' || strcmp(dstsd->ignore[i].name, sd->status.name) == 0 ) break; }while(0);
  if(i < 20 && dstsd->ignore[i].name[0] != '\0') {
   clif_wis_end( *sd, ACKWHISPER_IGNORED );
   return;
  }
 }


 clif_wis_end( *sd, ACKWHISPER_SUCCESS );


 clif_wis_message(dstsd, sd->status.name, message, strlen(message)+1, 0);
}





void clif_parse_Broadcast(int32 fd, map_session_data* sd) {
 const PACKET_CZ_BROADCAST* p = reinterpret_cast<PACKET_CZ_BROADCAST*>( (session[fd]->rdata + session[fd]->rdata_pos + (0)) );

 if( p->packetSize < sizeof( *p ) ){
  return;
 }

 char message[(255 + 1)];

 safestrncpy( message, p->message, std::min<size_t>( sizeof( message ), p->packetSize - sizeof( *p ) + 1 ) );

 char command[(255 + 1)];

 safesnprintf( command, sizeof( command ),"%ckami %s", atcommand_symbol, message );

 is_atcommand(fd, sd, command, 1);
}






void clif_parse_TakeItem(int32 fd, map_session_data *sd)
{
 flooritem_data *fitem;
 int32 map_object_id;


 map_object_id = (*(uint32*)(session[fd]->rdata + session[fd]->rdata_pos + (packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))].pos[0])));

 fitem = (flooritem_data*)map_id2bl(map_object_id);

 do {
  if (( (sd)->state.dead_sit == 1 )) {
   clif_clearunit_area( *sd, CLR_DEAD );
   break;
  }

  if (fitem == nullptr || fitem->type != BL_ITEM || fitem->m != sd->m)
   break;

  if (pc_cant_act(sd))
   break;

  if (!pc_takeitem(sd, fitem))
   break;

  return;
 } while (0);

 clif_additem(sd,0,0,6);
}






void clif_parse_DropItem(int32 fd, map_session_data *sd){

 struct s_packet_db* info = &packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))];
 int32 item_index = (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[0]))) -2;
 int32 item_amount = (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[1]))) ;

 for(;;) {
  if (( (sd)->state.dead_sit == 1 ))
   break;

  if (pc_cant_act2(sd) || sd->npc_id)
   break;

  if (sd->sc.cant.drop)
   break;

  if (!pc_dropitem(sd, item_index, item_amount))
   break;

  if (battle_config.idletime_option&IDLE_DROPITEM)
   sd->idletime = last_tick;
  if (battle_config.hom_idle_no_share && sd->hd && battle_config.idletime_hom_option&IDLE_DROPITEM)
   sd->idletime_hom = last_tick;
  if (battle_config.mer_idle_no_share && sd->md && battle_config.idletime_mer_option&IDLE_DROPITEM)
   sd->idletime_mer = last_tick;

  return;
 }


 clif_dropitem( *sd, item_index, 0 );
}






