      answer.mantissa = 0;

      return answer;
    }

    answer.mantissa >>= -answer.power2 + 1;


    answer.mantissa += (answer.mantissa & 1);
    answer.mantissa >>= 1;







    answer.power2 = (answer.mantissa < (uint64_t(1) << binary::mantissa_explicit_bits())) ? 0 : 1;
