 for(i=0; i<count; i++)
 {
  pb_ad = results[i];
  (*(uint32*)(session[fd]->wdata + session[fd]->wdata_size + (i*size+5))) = pb_ad->index;
  safestrncpy(((char*)(session[fd]->wdata + session[fd]->wdata_size + (i*size+9))),pb_ad->charname,(23 + 1));
  (*(uint32*)(session[fd]->wdata + session[fd]->wdata_size + (i*size+33))) = pb_ad->starttime;
