void clif_guild_emblem( const map_session_data &sd, const struct mmo_guild &g )
{
 int32 fd = sd.fd;
 if( g.emblem_len <= 0 )
  return;

 do{ if( ( fd ) && session[( fd )]->wdata_size + ( g.emblem_len+12 ) > session[( fd )]->max_wdata ){ _realloc_writefifo( ( fd ), ( g.emblem_len+12 ), "/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/src/map/clif.cpp", 9040, __FUNCTION__ ); } }while( false );
 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (0)))=0x152;
 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (2)))=g.emblem_len+12;
 (*(uint32*)(session[fd]->wdata + session[fd]->wdata_size + (4)))=g.guild_id;
 (*(uint32*)(session[fd]->wdata + session[fd]->wdata_size + (8)))=g.emblem_id;
 memcpy((session[fd]->wdata + session[fd]->wdata_size + (12)),g.emblem_data,g.emblem_len);
 WFIFOSET(fd,(*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (2))));
}






