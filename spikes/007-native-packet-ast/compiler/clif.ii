void clif_parse_NpcSelectMenu(int32 fd,map_session_data *sd){
 struct s_packet_db* info = &packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))];
 int32 npc_id = (*(uint32*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[0])));
 uint8 select = (*(uint8*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[1])));


 if( sd->npc_idle_timer == -1 && !sd->state.ignoretimeout )
  return;


 if( (select > sd->npc_menu && select != 0xff) || select == 0 ) {
   TBL_NPC* nd = map_id2nd(npc_id);
   ShowWarning("Invalid menu selection on npc %d:'%s' - got %d, valid range is [%d..%d] (player AID:%d, CID:%d, name:'%s')!\n", npc_id, (nd)?nd->name:"invalid npc id", select, 1, sd->npc_menu, sd->id, sd->status.char_id, sd->status.name);
   clif_GM_kick(nullptr,sd);
  return;
 }

 sd->npc_menu = select;

 if( battle_config.idletime_option&IDLE_NPC_MENU ){
  sd->idletime = last_tick;
 }

 npc_scriptcont(sd,npc_id, false);
}




