void clif_parse_debug(int32 fd,map_session_data *sd)
{
 int16 packet_len;


 uint16 cmd = (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)));

 if( sd ) {
  packet_len = packet_db[cmd].len;

  if( packet_len == 0 )
  {
   packet_len = static_cast<decltype(packet_len)>( (session[fd]->flag.eof ? 0 : session[fd]->rdata_size - session[fd]->rdata_pos) );
  }
  else if( packet_len == -1 )
  {
   packet_len = (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (2)));
  }
  ShowDebug("Packet debug of 0x%04X (length %d), %s session #%d, %d/%d (AID/CID)\n", cmd, packet_len, sd->state.active ? "authed" : "unauthed", fd, sd->status.account_id, sd->status.char_id);
 }
 else
 {
  packet_len = static_cast<decltype(packet_len)>( (session[fd]->flag.eof ? 0 : session[fd]->rdata_size - session[fd]->rdata_pos) );
  ShowDebug("Packet debug of 0x%04X (length %d), session #%d\n", cmd, packet_len, fd);
 }

 ShowDump((session[fd]->rdata + session[fd]->rdata_pos + (0)), packet_len);
}




