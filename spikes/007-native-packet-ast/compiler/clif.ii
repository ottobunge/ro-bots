  }
 }

}



void clif_autospell( map_session_data& sd, uint16 skill_lv ){
 struct s_autospell_requirement{
  uint16 skill_id;
  uint16 required_autospell_skill_lv;
 };
# 8429 "/nix/store/9fnslka6gqn93qwrwzvj07i929fmhv68-source/src/map/clif.cpp"
 const std::vector<s_autospell_requirement> autospell_skills = {
  { MG_NAPALMBEAT, 0 },
  { MG_COLDBOLT, 1 },
  { MG_FIREBOLT, 1 },
  { MG_LIGHTNINGBOLT, 1 },
  { MG_SOULSTRIKE, 4 },
  { MG_FIREBALL, 7 },
  { MG_FROSTDIVER, 9 },
 };
# 8456 "/nix/store/9fnslka6gqn93qwrwzvj07i929fmhv68-source/src/map/clif.cpp"
 PACKET_ZC_AUTOSPELLLIST p = {};

 p.packetType = HEADER_ZC_AUTOSPELLLIST;

 size_t count = 0;
 for( const s_autospell_requirement& requirement : autospell_skills ){
  if( count == ( sizeof(p.skills)/sizeof((p.skills)[0]) ) ){
   break;
  }

  if( skill_lv > requirement.required_autospell_skill_lv && pc_checkskill( &sd, requirement.skill_id ) ){
   p.skills[count++] = requirement.skill_id;
  }else{
   p.skills[count++] = 0;
  }
 }

 clif_send( &p, sizeof( p ), &sd, SELF );


 sd.menuskill_id = SA_AUTOSPELL;
 sd.menuskill_val = skill_lv;
}




void clif_devotion( const block_list* src, const map_session_data* tsd ) {
 unsigned char buf[56];

 (void)(src);
 memset(buf,0,packet_db[0x1cf].len);

 (*(uint16*)(((uint8*)((buf))) + ((0)))) = 0x1cf;
 (*(uint32*)(((uint8*)((buf))) + ((2)))) = src->id;
 if( src->type == BL_MER ){
  const s_mercenary_data *md = static_cast<const s_mercenary_data*>(src);
  if( md && md->master && md->devotion_flag )
   (*(uint32*)(((uint8*)((buf))) + ((6)))) = md->master->id;

  (*(uint16*)(((uint8*)((buf))) + ((26)))) = skill_get_range2(src, ML_DEVOTION, mercenary_checkskill(md, ML_DEVOTION), false);
 }
 else
 {
  int32 i;
  const map_session_data* sd = ( ((src) == nullptr || (src)->type != (BL_PC)) ? nullptr : static_cast< typename std::conditional< std::is_const<std::remove_pointer_t<decltype(src)>>::value, const TBL_PC*, TBL_PC* >::type >(src) );
  if( sd == nullptr )
   return;

  for( i = 0; i < 5 ; i++ )
   (*(uint32*)(((uint8*)((buf))) + ((6+4*i)))) = sd->devotion[i];
  (*(uint16*)(((uint8*)((buf))) + ((26)))) = skill_get_range2(src, CR_DEVOTION, pc_checkskill(sd, CR_DEVOTION), false);
 }

 if( tsd )
  clif_send(buf, packet_db[0x1cf].len, tsd, SELF);
 else
  clif_send(buf, packet_db[0x1cf].len, src, AREA);
}




