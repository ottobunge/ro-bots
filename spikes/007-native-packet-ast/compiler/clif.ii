void clif_parse_ChatRoomStatusChange(int32 fd, map_session_data* sd){
 if( sd == nullptr ){
  return;
 }

 const PACKET_CZ_CHANGE_CHATROOM* p = reinterpret_cast<PACKET_CZ_CHANGE_CHATROOM*>( (session[fd]->rdata + session[fd]->rdata_pos + (0)) );
 size_t len = p->packetSize - sizeof( *p );

 if( len <= 0 )
  return;

 char s_password[(8 + 1)];
 char s_title[(36 + 1)];

 safestrncpy( s_password, p->password, sizeof( s_password ) );

 safestrncpy( s_title, p->title, std::min<size_t>( len + 1, (36 + 1) ) );

 chat_changechatstatus( sd, s_title, s_password, p->limit, p->type );
}







