 iter = ( (channel->users)->iterator(channel->users) );
 for( user = (map_session_data *)( db_data2ptr((iter)->first((iter),nullptr)) ); ( (iter)->exists(iter) ); user = (map_session_data *)( db_data2ptr((iter)->next((iter),nullptr)) ) ) {
  clif_send(buf, len, user, SELF);
 }
 ( (iter)->destroy(iter) );
