struct s_item_combo {
 std::vector<t_itemid> nameid;
 script_code *script;
 uint16 id;

 ~s_item_combo() {
  if (this->script) {
   script_free_code(this->script);
   this->script = nullptr;
  }

  this->nameid.clear();
 }
};

