 for(i=0;i<20;i++){
  (*(uint32*)(session[fd]->wdata + session[fd]->wdata_size + (i*28+4)))=i;
  safestrncpy(((char*)(session[fd]->wdata + session[fd]->wdata_size + (i*28+8))),g->guild.position[i].name,(23 + 1));
 }
 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (2)))=i*28+4;
 WFIFOSET(fd,(*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (2))));
}
