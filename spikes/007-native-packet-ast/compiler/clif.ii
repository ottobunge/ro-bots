void clif_parse_bg_queue_apply_request(int32 fd, map_session_data *sd)
{
 if (!battle_config.feature_bgqueue)
  return;

 (void)(sd);

 int16 type = (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (2)));
 char name[(23 + 1)];

 safestrncpy(name, ((char*)(session[fd]->rdata + session[fd]->rdata_pos + (4))), (23 + 1));

 if (sd->bg_queue_id > 0) {

  clif_bg_queue_apply_result(BG_APPLY_DUPLICATE, name, sd);
  return;
 } else if (type == 1)
  bg_queue_join_solo(name, sd);
 else if (type == 2)
  bg_queue_join_party(name, sd);
 else if (type == 4)
  bg_queue_join_guild(name, sd);
 else {
  ShowWarning("clif_parse_bg_queue_apply_request: Received invalid queue type: %d from player %s (AID:%d CID:%d).\n", type, sd->status.name, sd->status.account_id, sd->status.char_id);
  clif_bg_queue_apply_result(BG_APPLY_INVALID_APP, name, sd);
  return;
 }
}




