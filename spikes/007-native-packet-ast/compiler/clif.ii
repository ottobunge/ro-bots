void clif_parse_GuildRequestInfo(int32 fd, map_session_data *sd)
{
 int32 type = (*(uint32*)(session[fd]->rdata + session[fd]->rdata_pos + (packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))].pos[0])));
 if( !sd->status.guild_id && !sd->bg_id )
  return;

 switch( type )
 {
 case 0:
  clif_guild_basicinfo( *sd );
  clif_guild_allianceinfo(*sd);
  clif_guild_castle_list(*sd);
  break;
 case 1:
  clif_guild_positionnamelist(sd);
  clif_guild_memberlist( *sd );
  break;
 case 2:
  clif_guild_positionnamelist(sd);
  clif_guild_positioninfolist(*sd);
  break;
 case 3:
  clif_guild_skillinfo( *sd );
  break;
 case 4:
  clif_guild_expulsionlist(*sd);
  break;
 default:
  ShowError("clif: guild request info: unknown type %d\n", type);
  break;
 }
}




void clif_parse_GuildChangePositionInfo(int32 fd, map_session_data *sd)
{
 int32 i;
 struct s_packet_db* info = &packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))];
 int32 len = (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[0])));
 int32 idxgpos = info->pos[1];

 if(!sd->state.gmaster_flag)
  return;

 for(i = idxgpos; i < len; i += 40 ){
  guild_change_position(sd->status.guild_id, (*(uint32*)(session[fd]->rdata + session[fd]->rdata_pos + (i))), (*(uint32*)(session[fd]->rdata + session[fd]->rdata_pos + (i+4))), (*(uint32*)(session[fd]->rdata + session[fd]->rdata_pos + (i+12))), ((char*)(session[fd]->rdata + session[fd]->rdata_pos + (i+16))));
 }
}




void clif_parse_GuildChangeMemberPosition( int32 fd, map_session_data *sd ){
 if(!sd->state.gmaster_flag)
  return;

 const PACKET_CZ_REQ_CHANGE_MEMBERPOS* p = reinterpret_cast<PACKET_CZ_REQ_CHANGE_MEMBERPOS*>( (session[fd]->rdata + session[fd]->rdata_pos + (0)) );

 int16 entries = ( p->packetLength - sizeof( *p ) ) / sizeof( p->list[0] );

 for( int16 i = 0; i < entries; i++ ){
  const PACKET_CZ_REQ_CHANGE_MEMBERPOS_sub& entry = p->list[i];


  if( entry.position == 0 ){
   if( !battle_config.guild_leaderchange_woe && (agit_flag || agit2_flag || agit3_flag) ){
    clif_msg( *sd, MSI_IMPOSSIBLE_CHANGE_GUILD_MASTER_IN_SIEGE_TIME );
    return;
   }

   if( battle_config.guild_leaderchange_delay && tick_diff(time( nullptr ),sd->guild->guild.last_leader_change) < battle_config.guild_leaderchange_delay ){
    clif_msg( *sd, MSI_IMPOSSIBLE_CHANGE_GUILD_MASTER_NOT_TIME );
    return;
   }

   guild_gm_change( sd->status.guild_id, entry.CID );


   return;
  }else if( entry.position > 0 ){
   guild_change_memberposition( sd->status.guild_id, entry.AID, entry.CID, entry.position );
  }
 }
}




static void clif_parse_GuildRequestEmblem( int32 fd, map_session_data* sd ){
 int32 guild_id = (*(uint32*)(session[fd]->rdata + session[fd]->rdata_pos + (packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))].pos[0])));

 auto g = guild_search(guild_id);

 if (g)
  clif_guild_emblem(*sd, g->guild);
}



enum e_result_validate_emblem {
 EMBVALIDATE_SUCCESS = 0,
 EMBVALIDATE_ERR_RAW_FILEFORMAT,
 EMBVALIDATE_ERR_TRANSPARENCY
};

static enum e_result_validate_emblem clif_validate_emblem(const uint8* emblem, unsigned long emblem_len)
{
 uint8 buf[1800];
 unsigned long buf_len = sizeof(buf);
 int32 offset = 0;

 if(!(( decode_zip(buf, &buf_len, emblem, emblem_len) == 0 && buf_len >= 18 )
  && (*(uint16*)(((uint8*)((buf))) + ((0)))) == 0x4d42
  && (*(uint32*)(((uint8*)((buf))) + ((2)))) == buf_len
  && (offset = (*(uint32*)(((uint8*)((buf))) + ((10))))) < buf_len
  ))
  return EMBVALIDATE_ERR_RAW_FILEFORMAT;

 if(inter_config.emblem_transparency_limit != 100) {
  int32 i, transcount = 1, tmp[3];
  for(i = offset; i < buf_len-1; i++) {
   int32 j = i%3;
   tmp[j] = (*(uint32*)(((uint8*)((buf))) + ((i))));
   if(j == 2 && (tmp[0] == 0xFFFF00FF) && (tmp[1] == 0xFFFF00) && (tmp[2] == 0xFF00FFFF))
    transcount++;
  }
  if(((transcount*300)/(buf_len-offset)) > inter_config.emblem_transparency_limit)
   return EMBVALIDATE_ERR_TRANSPARENCY;
 }

 return EMBVALIDATE_SUCCESS;
}




void clif_parse_GuildChangeEmblem(int32 fd,map_session_data *sd){
 if( sd == nullptr ){
  return;
 }

 struct s_packet_db* info = &packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))];
 unsigned long emblem_len = (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[0])))-4;
 const uint8* emblem = (session[fd]->rdata + session[fd]->rdata_pos + (info->pos[1]));
 int32 emb_val=0;

 if( !emblem_len || !sd->state.gmaster_flag )
  return;

 if(!(inter_config.emblem_woe_change) && (agit_flag || agit2_flag || agit3_flag) ){
  clif_messagecolor_target(sd, color_table[COLOR_RED], map_msg_txt(sd,385), false, SELF, nullptr);
  return;
 }
 emb_val = clif_validate_emblem(emblem, emblem_len);
 if(emb_val == EMBVALIDATE_ERR_RAW_FILEFORMAT){
  ShowWarning("clif_parse_GuildChangeEmblem: Rejected malformed guild emblem (size=%lu, accound_id=%d, char_id=%d, guild_id=%d).\n", emblem_len, sd->status.account_id, sd->status.char_id, sd->status.guild_id);
  clif_messagecolor_target(sd, color_table[COLOR_RED], map_msg_txt(sd,386), false, SELF, nullptr);
  return;
 } else if(emb_val == EMBVALIDATE_ERR_TRANSPARENCY){
  char output[128];
  safesnprintf(output,sizeof(output),map_msg_txt(sd,387),inter_config.emblem_transparency_limit);
  clif_messagecolor_target(sd, color_table[COLOR_RED], output, false, SELF, nullptr);
  return;
 }

 guild_change_emblem( *sd, emblem_len, (const char*)emblem );
}



