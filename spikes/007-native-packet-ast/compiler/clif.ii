template<class Writer>
void Emitter<Writer>::_write_doc(size_t id)
{
    do { if(!(m_tree->is_doc(id))) { if(c4::is_debugger_attached()) { ::debug_break(); }; c4::yml::error("check failed: " "m_tree->is_doc(id)", c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/emit.def.hpp", 151, 0)); } } while(0);
