  if(tbl->type == BL_SKILL)
   clif_clearchar_skillunit( *((skill_unit *)tbl), *sd );
  else if(((vd=status_get_viewdata(tbl)) && vd->look[LOOK_BASE] != JT_INVISIBLE) &&
   !clif_npc_mayapurple( *tbl ) )
   clif_clearunit_single( tbl->id, CLR_OUTSIGHT, *sd );
 }
