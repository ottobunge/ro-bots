void clif_messagecolor_target(const block_list* bl, unsigned long color, const char *msg, bool rgb2bgr, enum send_target type, const map_session_data* sd) {
 uint16 msg_len = (uint16)(strlen(msg) + 1);
 uint8 buf[(255 + 1)];

 (void)(bl);

 if (msg_len > sizeof(buf) - 12) {
  ShowWarning("clif_messagecolor: Truncating too long message '%s' (len=%u).\n", msg, msg_len);
  msg_len = sizeof(buf) - 12;
 }

 if (rgb2bgr)
  color = (color & 0x0000FF) << 16 | (color & 0x00FF00) | (color & 0xFF0000) >> 16;

 (*(uint16*)(((uint8*)((buf))) + ((0)))) = 0x2C1;
 (*(uint16*)(((uint8*)((buf))) + ((2)))) = msg_len + 12;
 (*(uint32*)(((uint8*)((buf))) + ((4)))) = bl->id;
 (*(uint32*)(((uint8*)((buf))) + ((8)))) = color;
 memcpy(((char*)(((uint8*)((buf))) + ((12)))), msg, msg_len);

 clif_send(buf, (*(uint16*)(((uint8*)((buf))) + ((2)))), (sd == nullptr ? bl : &(*sd)), type);
}







void clif_refresh_storagewindow(map_session_data *sd) {

 if( sd->state.storage_flag == 1 ) {
  storage_sortitem(sd->storage.u.items_storage, ( sizeof(sd->storage.u.items_storage)/sizeof((sd->storage.u.items_storage)[0]) ));
  clif_storagelist(sd, sd->storage.u.items_storage, ( sizeof(sd->storage.u.items_storage)/sizeof((sd->storage.u.items_storage)[0]) ), storage_getName(0));
  clif_updatestorageamount(*sd, sd->storage.amount, sd->storage.max_amount);
 }


 if( sd->state.storage_flag == 2 ) {
  struct s_storage *gstor = guild2storage2(sd->status.guild_id);

  if( !gstor )
   intif_request_guild_storage(sd->status.account_id, sd->status.guild_id);
  else {
   storage_sortitem(gstor->u.items_guild, ( sizeof(gstor->u.items_guild)/sizeof((gstor->u.items_guild)[0]) ));
   clif_storagelist(sd, gstor->u.items_guild, ( sizeof(gstor->u.items_guild)/sizeof((gstor->u.items_guild)[0]) ), "Guild Storage");
   clif_updatestorageamount(*sd, gstor->amount, gstor->max_amount);
  }
 }

 if (sd->state.storage_flag == 3) {
  storage_sortitem(sd->premiumStorage.u.items_storage, ( sizeof(sd->premiumStorage.u.items_storage)/sizeof((sd->premiumStorage.u.items_storage)[0]) ));
  clif_storagelist(sd, sd->premiumStorage.u.items_storage, ( sizeof(sd->premiumStorage.u.items_storage)/sizeof((sd->premiumStorage.u.items_storage)[0]) ), storage_getName(sd->premiumStorage.stor_id));
  clif_updatestorageamount(*sd, sd->premiumStorage.amount, sd->premiumStorage.max_amount);
 }
}


void clif_refresh(map_session_data *sd)
{
 (void)(sd);

 clif_changemap( *sd, sd->m, sd->x, sd->y );
 clif_inventorylist(sd);
 clif_equipswitch_list(sd);
 if(( (sd)->sc.getSCE(SC_PUSH_CART) )) {
  clif_cartlist(sd);
  clif_updatestatus(*sd,SP_CARTINFO);
 }
 clif_updatestatus(*sd,SP_WEIGHT);
 clif_updatestatus(*sd,SP_MAXWEIGHT);
 clif_updatestatus(*sd,SP_STR);
 clif_updatestatus(*sd,SP_AGI);
 clif_updatestatus(*sd,SP_VIT);
 clif_updatestatus(*sd,SP_INT);
 clif_updatestatus(*sd,SP_DEX);
 clif_updatestatus(*sd,SP_LUK);
# 9867 "/nix/store/9fnslka6gqn93qwrwzvj07i929fmhv68-source/src/map/clif.cpp"
 if (sd->spiritball)
  clif_spiritball( sd, sd, SELF );
 clif_millenniumshield_single( *sd, *sd );
 clif_spiritcharm_single( *sd, *sd );
 if (sd->soulball)
  clif_soulball( sd, sd, SELF );
 if (sd->servantball)
  clif_servantball( *sd, sd, SELF );
 if (sd->abyssball)
  clif_abyssball( *sd, sd, SELF );
 clif_refresh_clothcolor( *sd, SELF );
 if(((sd->hd) && (sd->hd)->homunculus.vaporize == HOM_ST_ACTIVE && (sd->hd)->battle_status.hp > 0))
  clif_send_homdata( *sd->hd, SP_ACK );
 if( sd->md ) {
  clif_mercenary_info(sd);
  clif_mercenary_skillblock(sd);
 }
 if( sd->ed )
  clif_elemental_info(sd);
 map_foreachinallrange(clif_getareachar,sd,battle_config.area_size,BL_ALL,sd);
 clif_weather_check(sd);
 if( sd->chatID )
  chat_leavechat(sd,0);
 if( sd->state.vending )
  clif_openvending( *sd );
 if( ( (sd)->vd.dead_sit == 2 ) )
  clif_sitting(*sd);
 if( ( (sd)->state.dead_sit == 1 ) )
  clif_clearunit_single( sd->id, CLR_DEAD, *sd );
 else
  clif_changed_dir(*sd, SELF);
 clif_efst_status_change_sub(sd,sd,SELF);



 if (sd->state.trading)
  trade_tradecancel(sd);

 if (sd->state.buyingstore)
  buyingstore_close(sd);


 mail_clear(sd);

 clif_loadConfirm( sd );

 if( disguised(sd) ) {
  int16 disguise = sd->disguise;
  pc_disguise(sd, 0);
  pc_disguise(sd, disguise);
 }
 clif_refresh_storagewindow(sd);
}
# 9928 "/nix/store/9fnslka6gqn93qwrwzvj07i929fmhv68-source/src/map/clif.cpp"
void clif_name( const block_list* src, const block_list* bl, send_target target ){
 (void)(src);
 (void)(bl);

 switch( bl->type ){
  case BL_PC: {
   PACKET_ZC_ACK_REQNAMEALL packet = { 0 };

   packet.packet_id = HEADER_ZC_ACK_REQNAMEALL;
   packet.gid = bl->id;

   map_session_data *sd = (map_session_data *)bl;


   if( src == bl && target == SELF && sd->disguise ){
    packet.gid = -bl->id;
   }

   if( sd->fakename[0] ) {
    safestrncpy( packet.name, sd->fakename, (23 + 1) );
    clif_send( &packet, sizeof(packet), src, target );
    return;
   }

   safestrncpy( packet.name, sd->status.name, (23 + 1) );

   party_data *p = nullptr;

   if( sd->status.party_id ){
    p = party_search( sd->status.party_id );
   }


   if( p && ( sd->guild || battle_config.display_party_name ) ){
    safestrncpy( packet.party_name, p->party.name, (23 + 1) );
   }

   if( sd->guild ){
    int32 position;


    position = guild_getposition(*sd);

    safestrncpy( packet.guild_name, sd->guild->guild.name, (23 + 1) );
    safestrncpy( packet.position_name, sd->guild->guild.position[position].name, (23 + 1) );
   }else if( sd->clan ){
    safestrncpy( packet.position_name, sd->clan->name, (23 + 1) );
   }


   packet.title_id = sd->status.title_id;


   clif_send(&packet, sizeof(packet), src, target);
  }
   break;

  case BL_HOM:
  case BL_MER:
  case BL_PET:
  case BL_NPC:
  case BL_ELEM: {
   PACKET_ZC_ACK_REQNAMEALL_NPC packet = { 0 };

   packet.packet_id = HEADER_ZC_ACK_REQNAMEALL_NPC;
   packet.gid = bl->id;

   switch (bl->type) {
    case BL_HOM:
     memcpy(packet.name, static_cast<const homun_data*>(bl)->homunculus.name, (23 + 1));
     break;
    case BL_MER:
     memcpy(packet.name, static_cast<const s_mercenary_data*>(bl)->db->name.c_str(), (23 + 1));
     break;
    case BL_PET:
     safestrncpy(packet.name, static_cast<const pet_data*>(bl)->pet.name, (23 + 1));
     break;
    case BL_NPC:
     safestrncpy(packet.name, static_cast<const npc_data*>(bl)->name, (23 + 1));
     break;
    case BL_ELEM:
     safestrncpy(packet.name, static_cast<const s_elemental_data*>(bl)->db->name.c_str(), (23 + 1));
     break;
   }


   const unit_data* ud = unit_bl2ud(bl);

   if (ud != nullptr) {
    memcpy(packet.title, ud->title, (23 + 1));
    packet.groupId = ud->group_id;
   }


   clif_send(&packet, sizeof(packet), src, target);
  }
   break;
  case BL_MOB: {
   const mob_data* md = static_cast<const mob_data*>(bl);

   if( md->guardian_data && md->guardian_data->guild_id ){
    PACKET_ZC_ACK_REQNAMEALL packet = { 0 };

    packet.packet_id = HEADER_ZC_ACK_REQNAMEALL;
    packet.gid = bl->id;
    safestrncpy( packet.name, md->name, (23 + 1) );
    safestrncpy( packet.guild_name, md->guardian_data->guild_name, (23 + 1) );
    safestrncpy( packet.position_name, md->guardian_data->castle->castle_name, (23 + 1) );

    clif_send(&packet, sizeof(packet), src, target);
   }else if( battle_config.show_mob_info ){
    PACKET_ZC_ACK_REQNAMEALL packet = { 0 };

    packet.packet_id = HEADER_ZC_ACK_REQNAMEALL;
    packet.gid = bl->id;
    safestrncpy( packet.name, md->name, (23 + 1) );

    char mobhp[50], *str_p = mobhp;

    if( battle_config.show_mob_info&4 ){
     str_p += sprintf( str_p, "Lv. %d | ", md->level );
    }

    if( battle_config.show_mob_info&1 ){
     str_p += sprintf( str_p, "HP: %u/%u | ", md->status.hp, md->status.max_hp );
    }

    if( battle_config.show_mob_info&2 ){
     str_p += sprintf( str_p, "HP: %u%% | ", get_percentage( md->status.hp, md->status.max_hp ) );
    }


    if( str_p != mobhp ){
     *(str_p-3) = '\0';
     safestrncpy( packet.party_name, mobhp, (23 + 1) );
    }

    clif_send(&packet, sizeof(packet), src, target);
   } else {
    PACKET_ZC_ACK_REQNAMEALL_NPC packet = { 0 };

    packet.packet_id = HEADER_ZC_ACK_REQNAMEALL_NPC;
    packet.gid = bl->id;
    safestrncpy(packet.name, md->name, (23 + 1));


    const unit_data* ud = unit_bl2ud(bl);

    if (ud != nullptr) {
     memcpy(packet.title, ud->title, (23 + 1));
     packet.groupId = ud->group_id;
    }


    clif_send(&packet, sizeof(packet), src, target);
   }
  }
   break;
  case BL_CHAT:
  case BL_SKILL:

   return;
  default:
   ShowError("clif_name: bad type %d(%d)\n", bl->type, bl->id);
   return;
 }
}







