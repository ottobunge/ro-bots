 uint16 packet_id = (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)));
 int32 mail_id = (int32)(*(uint64*)(session[fd]->rdata + session[fd]->rdata_pos + (2)));

 int32 attachment = packet_id == 0x9f1 ? MAIL_ATT_ZENY : packet_id == 0x9f3 ? MAIL_ATT_ITEM : MAIL_ATT_NONE;


