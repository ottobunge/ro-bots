void clif_parse_NpcBuyListSend( int32 fd, map_session_data* sd ){
 const PACKET_CZ_PC_PURCHASE_ITEMLIST *p = reinterpret_cast<PACKET_CZ_PC_PURCHASE_ITEMLIST*>( (session[fd]->rdata + session[fd]->rdata_pos + (0)) );

 uint16 n = ( p->packetLength - sizeof( *p ) ) / sizeof( p->items[0] );
 e_purchase_result result;

 if( sd->state.trading || !sd->npc_shopid )
  result = e_purchase_result::PURCHASE_FAIL_MONEY;
 else{
  std::vector<s_npc_buy_list> items = {};

  items.reserve( n );

  for( uint16 i = 0; i < n; i++ ){
   s_npc_buy_list item = {};

   item.nameid = p->items[i].itemId;
   item.qty = p->items[i].amount;

   items.push_back( item );
  }

  result = npc_buylist( sd, items );
 }

 sd->npc_shopid = 0;
 clif_npc_buy_result(sd, result);
}







void clif_npc_sell_result(map_session_data* sd, unsigned char result)
{
 int32 fd = sd->fd;

 do{ if( ( fd ) && session[( fd )]->wdata_size + ( packet_db[0xcb].len ) > session[( fd )]->max_wdata ){ _realloc_writefifo( ( fd ), ( packet_db[0xcb].len ), "/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/src/map/clif.cpp", 12338, __FUNCTION__ ); } }while( false );
 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (0))) = 0xcb;
 (*(uint8*)(session[fd]->wdata + session[fd]->wdata_size + (2))) = result;
 WFIFOSET(fd,packet_db[0xcb].len);
}




