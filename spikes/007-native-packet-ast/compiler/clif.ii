 if(map_getmapflag_sub(sd->m, MF_GUILDLOCK, nullptr)) {
  clif_displaymessage(fd, map_msg_txt(sd,228));
  return;
 }

 if(sd->clan){

  return;
 }

 guild_create( *sd, name );
}




