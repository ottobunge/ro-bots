template<class T>
bool from_chars_float(csubstr buf, T *__restrict__ val)
{
    static_assert(std::is_floating_point<T>::value, "must be floating point");
    if(__builtin_expect(from_chars(buf, val), 1))
    {
        return true;
    }
    else if(__builtin_expect(buf == ".nan" || buf == ".NaN" || buf == ".NAN", 0))
    {
        *val = std::numeric_limits<T>::quiet_NaN();
        return true;
    }
    else if(__builtin_expect(buf == ".inf" || buf == ".Inf" || buf == ".INF", 0))
    {
        *val = std::numeric_limits<T>::infinity();
        return true;
    }
    else if(__builtin_expect(buf == "-.inf" || buf == "-.Inf" || buf == "-.INF", 0))
    {
        *val = -std::numeric_limits<T>::infinity();
        return true;
    }
    else
    {
        return false;
    }
}







