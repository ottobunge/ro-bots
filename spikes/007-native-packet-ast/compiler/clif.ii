  if( sd->mail.item[i].nameid == 0 ){
   break;
  }

  if( sd->mail.item[i].index < 0 || sd->mail.item[i].index >= ( 100 + 0 ) ){
   continue;
  }

  item_data* id = sd->inventory_data[sd->mail.item[i].index];

  if( id == nullptr ){
   continue;
  }

  total += sd->mail.item[i].amount * ( id->weight / 10 );
 }

 p.weight = total;
 clif_send(&p, sizeof(p), sd, SELF);
}
