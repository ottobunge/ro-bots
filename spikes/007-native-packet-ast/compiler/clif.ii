void clif_parse_Mail_send(int32 fd, map_session_data *sd){
# 16833 "/nix/store/9fnslka6gqn93qwrwzvj07i929fmhv68-source/src/map/clif.cpp"
 uint16 length = (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (2)));



 constexpr uint16 headerLength = 68;


 if( length < headerLength ){
  ShowWarning("Too short...\n");
  clif_Mail_send(sd, WRITE_MAIL_FAILED);
  return;
 }

 if( mail_invalid_operation( sd ) ){
  return;
 }


 if( !sd->state.mail_writing ){
  return;
 }

 char receiver[(23 + 1)];

 safestrncpy(receiver, ((char*)(session[fd]->rdata + session[fd]->rdata_pos + (4))), (23 + 1));





 uint64 zeny = (*(uint64*)(session[fd]->rdata + session[fd]->rdata_pos + (52)));
