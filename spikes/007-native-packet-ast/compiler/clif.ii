void clif_noask_sub( const map_session_data& sd, const map_session_data& tsd, int32 type ){
 char output[(255 + 1)];


 clif_messagecolor_target(&sd, color_table[COLOR_LIGHT_GREEN], map_msg_txt(&sd,392), false, SELF, nullptr);


 safesnprintf( output, (255 + 1), map_msg_txt(&tsd,type), sd.status.name );
 clif_messagecolor_target(&tsd, color_table[COLOR_LIGHT_GREEN], output, false, SELF, nullptr);
}



void clif_parse_TradeRequest(int32 fd,map_session_data *sd)
{
 map_session_data *t_sd;

 t_sd = map_id2sd((*(uint32*)(session[fd]->rdata + session[fd]->rdata_pos + (packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))].pos[0]))));

 if(!sd->chatID && pc_cant_act(sd))
  return;

 if(t_sd){

  if(t_sd->state.noask) {
   clif_noask_sub( *sd, *t_sd, 393 );
   return;
  }

  if (t_sd->state.mail_writing) {

   clif_traderesponse(*sd,TRADE_ACK_BUSY);

   return;
  }
 }

 if( battle_config.basic_skill_check && pc_checkskill(sd,NV_BASIC) < 1 && pc_checkskill(sd, SU_BASIC_SKILL) < 1) {
  clif_skill_fail( *sd, 1 );
  return;
 }

 trade_traderequest(sd,t_sd);
}







