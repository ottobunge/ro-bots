template<class T>
bool atoi(csubstr str, T * __restrict__ v)
{
    static_assert(std::is_integral<T>::value);
    static_assert(std::is_signed<T>::value);

    if(__builtin_expect(str.len == 0, 0))
        return false;

    T sign = 1;
    size_t start = 0;
    if(str.str[0] == '-')
    {
        if(__builtin_expect(str.len == 1, 0))
            return false;
        ++start;
        sign = -1;
    }

    if(str.str[start] != '0')
    {
        if(__builtin_expect(! read_dec(str.sub(start), v), 0))
            return false;
    }
    else
    {
        if(str.len == start+1)
        {
            *v = 0;
            return true;
        }
        else
        {
            char pfx = str.str[start+1];
            if(pfx == 'x' || pfx == 'X')
            {
                if(__builtin_expect(str.len <= start + 2, 0))
                    return false;
                if(__builtin_expect(! read_hex(str.sub(start + 2), v), 0))
                    return false;
            }
            else if(pfx == 'b' || pfx == 'B')
            {
                if(__builtin_expect(str.len <= start + 2, 0))
                    return false;
                if(__builtin_expect(! read_bin(str.sub(start + 2), v), 0))
                    return false;
            }
            else if(pfx == 'o' || pfx == 'O')
            {
                if(__builtin_expect(str.len <= start + 2, 0))
                    return false;
                if(__builtin_expect(! read_oct(str.sub(start + 2), v), 0))
                    return false;
            }
            else
            {

                auto fno = str.first_not_of('0', start + 1);
                if(fno == csubstr::npos)
                {
                    *v = 0;
                    return true;
                }
                if(__builtin_expect(! read_dec(str.sub(fno), v), 0))
                {
                    return false;
                }
            }
        }
    }
    *v *= sign;
    return true;
}
# 853 "/nix/store/9fnslka6gqn93qwrwzvj07i929fmhv68-source/3rdparty/rapidyaml/ext/c4core/src/c4/charconv.hpp"
template<class T>
inline size_t atoi_first(csubstr str, T * __restrict__ v)
{
    csubstr trimmed = str.first_int_span();
    if(trimmed.len == 0)
        return csubstr::npos;
    if(atoi(trimmed, v))
        return static_cast<size_t>(trimmed.end() - str.begin());
    return csubstr::npos;
}
# 882 "/nix/store/9fnslka6gqn93qwrwzvj07i929fmhv68-source/3rdparty/rapidyaml/ext/c4core/src/c4/charconv.hpp"
template<class T>
bool atou(csubstr str, T * __restrict__ v)
{
    static_assert(std::is_integral<T>::value);

    if(__builtin_expect(str.len == 0 || str.front() == '-', 0))
        return false;

    if(str.str[0] != '0')
    {
        if(__builtin_expect(! read_dec(str, v), 0))
            return false;
    }
    else
    {
        if(str.len == 1)
        {
            *v = 0;
            return true;
        }
        else
        {
            char pfx = str.str[1];
            if(pfx == 'x' || pfx == 'X')
            {
                if(__builtin_expect(str.len <= 2, 0))
                    return false;
                return read_hex(str.sub(2), v);
            }
            else if(pfx == 'b' || pfx == 'B')
            {
                if(__builtin_expect(str.len <= 2, 0))
                    return false;
                return read_bin(str.sub(2), v);
            }
            else if(pfx == 'o' || pfx == 'O')
            {
                if(__builtin_expect(str.len <= 2, 0))
                    return false;
                return read_oct(str.sub(2), v);
            }
            else
            {

                auto fno = str.first_not_of('0');
                if(fno == csubstr::npos)
                {
                    *v = 0;
                    return true;
                }
                return read_dec(str.sub(fno), v);
            }
        }
    }
    return true;
}
# 946 "/nix/store/9fnslka6gqn93qwrwzvj07i929fmhv68-source/3rdparty/rapidyaml/ext/c4core/src/c4/charconv.hpp"
template<class T>
inline size_t atou_first(csubstr str, T *v)
{
    csubstr trimmed = str.first_uint_span();
    if(trimmed.len == 0)
        return csubstr::npos;
    if(atou(trimmed, v))
        return static_cast<size_t>(trimmed.end() - str.begin());
    return csubstr::npos;
}







