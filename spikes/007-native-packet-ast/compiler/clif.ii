   if( bl->m == tsd->m && session_isActive( fd = tsd->fd ) ){
    do{ if( ( fd ) && session[( fd )]->wdata_size + ( len ) > session[( fd )]->max_wdata ){ _realloc_writefifo( ( fd ), ( len ), "/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/src/map/clif.cpp", 509, __FUNCTION__ ); } }while( false );
    memcpy( (session[fd]->wdata + session[fd]->wdata_size + (0)), buf, len );
    WFIFOSET( fd, len );
   }
  }
  mapit_free(iter);
  break;

 case AREA:
 case AREA_WOSC:
  if (sd && bl->prev == nullptr)
   clif_send (buf, len, bl, SELF);
  [[fallthrough]];
 case AREA_WOC:
 case AREA_WOS:
  map_foreachinallarea(clif_send_sub, bl->m, bl->x-battle_config.area_size, bl->y-battle_config.area_size, bl->x+battle_config.area_size, bl->y+battle_config.area_size,
   BL_PC, buf, len, bl, type);
  break;
 case AREA_CHAT_WOC:
  map_foreachinallarea(clif_send_sub, bl->m, bl->x-(battle_config.area_size-5), bl->y-(battle_config.area_size-5),
   bl->x+(battle_config.area_size-5), bl->y+(battle_config.area_size-5), BL_PC, buf, len, bl, AREA_WOC);
  break;

 case CHAT:
 case CHAT_WOS:
  {
   chat_data *cd;
   if (sd) {
    cd = (chat_data*)map_id2bl(sd->chatID);
   } else if (bl->type == BL_CHAT) {
    cd = (chat_data*)bl;
   } else break;
   if (cd == nullptr)
    break;
   for(i = 0; i < cd->users; i++) {
    if (type == CHAT_WOS && cd->usersd[i] == sd)
     continue;
    if( session_isActive( fd = cd->usersd[i]->fd ) ){
     do{ if( ( fd ) && session[( fd )]->wdata_size + ( len ) > session[( fd )]->max_wdata ){ _realloc_writefifo( ( fd ), ( len ), "/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/src/map/clif.cpp", 547, __FUNCTION__ ); } }while( false );
     memcpy((session[fd]->wdata + session[fd]->wdata_size + (0)), buf, len);
     WFIFOSET(fd,len);
    }
   }
  }
  break;

 case PARTY_AREA:
 case PARTY_AREA_WOS:
  x0 = bl->x - battle_config.area_size;
  y0 = bl->y - battle_config.area_size;
  x1 = bl->x + battle_config.area_size;
  y1 = bl->y + battle_config.area_size;
  [[fallthrough]];
 case PARTY:
 case PARTY_WOS:
 case PARTY_SAMEMAP:
