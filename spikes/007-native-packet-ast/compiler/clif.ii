void clif_parse_equipswitch_request( int32 fd, map_session_data* sd ){

 int32 i;
 t_tick tick = gettick();
 uint16 skill_id = ALL_EQSWITCH, skill_lv = 1;

 if( tick_diff(tick,sd->equipswitch_tick) < 0 ) {

  return;
 }

 sd->equipswitch_tick = tick + skill_get_cooldown( skill_id, skill_lv );

 if( !battle_config.feature_equipswitch ){
  return;
 }

 do{ for( (i) = (0); (i) < (EQI_MAX); ++(i) ) if( sd->equip_switch_index[i] >= 0 ) break; }while(0);

 if( i == EQI_MAX ){

  clif_equipswitch_reply( sd, false );
  return;
 }

 if( ( (sd)->vd.dead_sit == 2 ) && !pc_setstand( sd, false ) ){
  return;
 }

 clif_parse_skill_toid( sd, skill_id, skill_lv, sd->id );

}



