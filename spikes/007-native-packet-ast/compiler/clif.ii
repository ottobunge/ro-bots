 safestrncpy(((char*)(session[fd]->wdata + session[fd]->wdata_size + (4))), output, length );
 WFIFOSET(fd, (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (2))));







 log_chat(LOG_CHAT_GLOBAL, 0, sd->status.char_id, sd->status.account_id, mapindex_idx2name((sd->mapindex), __FUNCTION__), sd->x, sd->y, nullptr, message);

