namespace c4 {
namespace yml {

template<class Writer>
substr Emitter<Writer>::emit(EmitType_e type, Tree const& t, size_t id, bool error_on_excess)
{
    if(t.empty())
    {
        do { if(!((id == NONE))) { const char msg[] = "check failed: " "(id == NONE)"; if(c4::is_debugger_attached()) { ::debug_break(); }; ((t.callbacks())).m_error(msg, sizeof(msg), c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/emit.def.hpp", 0, 16, 0), ((t.callbacks())).m_user_data); } } while(0);
        return {};
    }
    do { if(!(id < t.size())) { const char msg[] = "check failed: " "id < t.size()"; if(c4::is_debugger_attached()) { ::debug_break(); }; (t.callbacks()).m_error(msg, sizeof(msg), c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/emit.def.hpp", 0, 19, 0), (t.callbacks()).m_user_data); } } while(0);
    m_tree = &t;
    if(type == EMIT_YAML)
        _emit_yaml(id);
    else if(type == EMIT_JSON)
        _do_visit_json(id);
    else
        do { const char msg[] = "unknown emit type"; if(c4::is_debugger_attached()) { ::debug_break(); }; (m_tree->callbacks()).m_error(msg, sizeof(msg), c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/emit.def.hpp", 0, 26, 0), (m_tree->callbacks()).m_user_data); } while(0);
    return this->Writer::_get(error_on_excess);
}

template<class Writer>
substr Emitter<Writer>::emit(EmitType_e type, Tree const& t, bool error_on_excess)
{
    if(t.empty())
        return {};
    return emit(type, t, t.root_id(), error_on_excess);
}

template<class Writer>
substr Emitter<Writer>::emit(EmitType_e type, NodeRef const& n, bool error_on_excess)
{
    do { if(!(n.valid())) { const char msg[] = "check failed: " "n.valid()"; if(c4::is_debugger_attached()) { ::debug_break(); }; (n.tree()->callbacks()).m_error(msg, sizeof(msg), c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/emit.def.hpp", 0, 41, 0), (n.tree()->callbacks()).m_user_data); } } while(0);
    return emit(type, *n.tree(), n.id(), error_on_excess);
}




template<class Writer>
void Emitter<Writer>::_emit_yaml(size_t id)
{



    auto dispatch = [this](size_t node){
        NodeType ty = m_tree->type(node);
        if(ty.marked_flow_sl())
            _do_visit_flow_sl(node, 0);
        else if(ty.marked_flow_ml())
            _do_visit_flow_ml(node, 0);
        else
        {
            _do_visit_block(node, 0);
        }
    };
    if(!m_tree->is_root(id))
    {
        if(m_tree->is_container(id) && !m_tree->type(id).marked_flow())
        {
            size_t ilevel = 0;
            if(m_tree->has_key(id))
