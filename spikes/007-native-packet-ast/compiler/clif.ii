void clif_parse_MoveItem( int32 fd, map_session_data* sd ){



 if(( (sd)->state.dead_sit == 1 )) {
  return;
 }

 const PACKET_CZ_INVENTORY_TAB* p = reinterpret_cast<PACKET_CZ_INVENTORY_TAB*>( (session[fd]->rdata + session[fd]->rdata_pos + (0)) );

 uint16 index = server_index( p->index );

 if( index >= ( 100 + 0 ) ){
  return;
 }

 if ( sd->inventory.u.items_inventory[index].favorite != 0 && p->favorite == true )
  sd->inventory.u.items_inventory[index].favorite = 0;
 else if( p->favorite == false )
  sd->inventory.u.items_inventory[index].favorite = 1;
 else
  return;

 clif_favorite_item( *sd, index );

}




