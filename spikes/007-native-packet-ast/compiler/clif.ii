template<class Writer>
void Emitter<Writer>::_do_visit_block(size_t node, size_t ilevel, size_t do_indent)
{
    do { if(!(!m_tree->is_stream(node))) { if(c4::is_debugger_attached()) { ::debug_break(); }; c4::yml::error("check failed: " "!m_tree->is_stream(node)", c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/emit.def.hpp", 369, 0)); } } while(0);
    do { if(!(m_tree->is_container(node) || m_tree->is_doc(node))) { if(c4::is_debugger_attached()) { ::debug_break(); }; c4::yml::error("check failed: " "m_tree->is_container(node) || m_tree->is_doc(node)", c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/emit.def.hpp", 370, 0)); } } while(0);
    do { if(!(m_tree->is_root(node) || (m_tree->parent_is_map(node) || m_tree->parent_is_seq(node)))) { if(c4::is_debugger_attached()) { ::debug_break(); }; c4::yml::error("check failed: " "m_tree->is_root(node) || (m_tree->parent_is_map(node) || m_tree->parent_is_seq(node))", c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/emit.def.hpp", 371, 0)); } } while(0);
    RepC ind = indent_to(do_indent * ilevel);

    if(m_tree->is_doc(node))
    {
        _write_doc(node);
        if(!m_tree->has_children(node))
            return;
    }
    else if(m_tree->is_container(node))
    {
        do { if(!(m_tree->is_map(node) || m_tree->is_seq(node))) { if(c4::is_debugger_attached()) { ::debug_break(); }; c4::yml::error("check failed: " "m_tree->is_map(node) || m_tree->is_seq(node)", c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/emit.def.hpp", 382, 0)); } } while(0);

        bool spc = false;
        bool nl = false;

        if(m_tree->has_key(node))
        {
            this->Writer::_do_write(ind);
            _writek(node, ilevel);
            this->Writer::_do_write(':');
            spc = true;
        }
        else if(!m_tree->is_root(node))
        {
            this->Writer::_do_write(ind);
            this->Writer::_do_write('-');
            spc = true;
        }

        if(m_tree->has_val_tag(node))
        {
            if(spc)
                this->Writer::_do_write(' ');
            _write_tag(m_tree->val_tag(node));
            spc = true;
            nl = true;
        }

        if(m_tree->has_val_anchor(node))
        {
            if(spc)
                this->Writer::_do_write(' ');
            this->Writer::_do_write('&');
            this->Writer::_do_write(m_tree->val_anchor(node));
            spc = true;
            nl = true;
        }

        if(m_tree->has_children(node))
        {
            if(m_tree->has_key(node))
                nl = true;
            else
                if(!m_tree->is_root(node) && !nl)
                    spc = true;
        }
        else
        {
            if(m_tree->is_seq(node))
                this->Writer::_do_write(" []\n");
            else if(m_tree->is_map(node))
                this->Writer::_do_write(" {}\n");
            return;
        }

        if(spc && !nl)
            this->Writer::_do_write(' ');

        do_indent = 0;
        if(nl)
        {
            this->Writer::_do_write('\n');
            do_indent = 1;
        }
    }

    size_t next_level = ilevel + 1;
    if(m_tree->is_root(node) || m_tree->is_doc(node))
        next_level = ilevel;

    _do_visit_block_container(node, next_level, do_indent);
}

template<class Writer>
void Emitter<Writer>::_do_visit_json(size_t id)
{
    do { if(!(!m_tree->is_stream(id))) { const char msg[] = "check failed: " "!m_tree->is_stream(id)"; if(c4::is_debugger_attached()) { ::debug_break(); }; (m_tree->callbacks()).m_error(msg, sizeof(msg), c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/emit.def.hpp", 0, 458, 0), (m_tree->callbacks()).m_user_data); } } while(0);
    if(m_tree->is_keyval(id))
    {
        _writek_json(id);
        this->Writer::_do_write(": ");
        _writev_json(id);
    }
    else if(m_tree->is_val(id))
    {
        _writev_json(id);
    }
    else if(m_tree->is_container(id))
    {
        if(m_tree->has_key(id))
        {
            _writek_json(id);
            this->Writer::_do_write(": ");
