void clif_parse_MoveToKafra(int32 fd, map_session_data *sd)
{
 int32 item_index, item_amount;

 struct s_packet_db* info = &packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))];

 if (( (sd)->npc_id || (sd)->state.vending || (sd)->state.buyingstore || (sd)->state.trading ))
  return;

 item_index = (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[0])))-2;
 item_amount = (*(uint32*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[1])));
 if (item_index < 0 || item_index >= ( 100 + 0 ) || item_amount < 1)
  return;
 if( sd->inventory.u.items_inventory[item_index].equipSwitch ){
  clif_msg( *sd, MSI_SWAP_EQUIPITEM_UNREGISTER_FIRST );
  return;
 }

 if (sd->state.storage_flag == 1)
  storage_storageadd(sd, &sd->storage, item_index, item_amount);
 else
 if (sd->state.storage_flag == 2)
  storage_guild_storageadd(sd, item_index, item_amount);
 else if (sd->state.storage_flag == 3)
  storage_storageadd(sd, &sd->premiumStorage, item_index, item_amount);
}






