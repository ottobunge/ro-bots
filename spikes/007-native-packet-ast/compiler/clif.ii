 packetLength = (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[0])));
 input = ((char*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[1])));


 if( packetLength < 4 ){
  ShowWarning("clif_process_message: Received malformed packet from player '%s' (no message data)!\n", sd->status.name);
  return false;
 }else{
  inputLength = packetLength - 4;
 }


 if( whisperFormat ) {

  if( inputLength < (23 + 1) + 1 ) {
   ShowWarning("clif_process_message: Received malformed packet from player '%s' (packet length is incorrect)!\n", sd->status.name);
   return false;
  }

  name = input;


  nameLength = strnlen( name, (23 + 1) - 1 );


  if( name[nameLength] != '\0' ) {
   ShowWarning("clif_process_message: Player '%s' sent an unterminated name!\n", sd->status.name);
   return false;
  }

  message = input + (23 + 1);
  messageLength = inputLength - (23 + 1);
 }else{

  size_t separatorLength = strnlen( separator, (23 + 1) );

  nameLength = strnlen( sd->status.name, (23 + 1) - 1 );


  if( inputLength < nameLength + separatorLength + 1 ){
   ShowWarning("clif_process_message: Received malformed packet from player '%s' (no username data)!\n", sd->status.name);
   return false;
  }

  name = input;


  if( strncmp( name, sd->status.name, nameLength ) ||
   strncmp( name + nameLength, separator, separatorLength ) )
  {

   ShowWarning("clif_process_message: Player '%s' sent a message using an incorrect name! Forcing a relog...\n", sd->status.name);
   set_eof(sd->fd);
   return false;
  }

  message = input + nameLength + separatorLength;
  messageLength = inputLength - nameLength - separatorLength;
 }
