  (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (i*size+39))) = pb_ad->p_detail.mapid;
  for(j=0; j<6; j++)
   (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (i*size+41+j*2))) = pb_ad->p_detail.job[j];
 }
 WFIFOSET(fd,(*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (2))));
}




