void clif_parse_HomMoveToMaster(int32 fd, map_session_data *sd){
 int32 id = (*(uint32*)(session[fd]->rdata + session[fd]->rdata_pos + (packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))].pos[0])));
 block_list *bl = nullptr;
 struct unit_data *ud = nullptr;

 if( sd->md && sd->md->id == id )
  bl = sd->md;
 else if( ((sd->hd) && (sd->hd)->homunculus.vaporize == HOM_ST_ACTIVE && (sd->hd)->battle_status.hp > 0) && sd->hd->id == id )
  bl = sd->hd;
 else
  return;

 unit_calc_pos(bl, sd->x, sd->y, sd->ud.dir);
 ud = unit_bl2ud(bl);
 unit_walktoxy(bl, ud->to_x, ud->to_y, 4);
}




void clif_parse_HomMoveTo(int32 fd, map_session_data *sd){

 const PACKET_CZ_REQUEST_MOVENPC* p = reinterpret_cast<const PACKET_CZ_REQUEST_MOVENPC*>( (session[fd]->rdata + session[fd]->rdata_pos + (0)) );
 block_list *bl = nullptr;
 int16 x, y;

 RBUFPOS( p->PosDir, 0, &x, &y, nullptr );

 if( sd->md && sd->md->id == p->GID )
  bl = sd->md;
 else if( ((sd->hd) && (sd->hd)->homunculus.vaporize == HOM_ST_ACTIVE && (sd->hd)->battle_status.hp > 0) && sd->hd->id == p->GID )
  bl = sd->hd;
 else
  return;

 if (x < 0 || y < 0 || (x == bl->x && y == bl->y))
  return;

 unit_walktoxy(bl, x, y, 4);

}






