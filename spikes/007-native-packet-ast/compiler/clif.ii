template<class I>
inline __attribute__((always_inline)) bool read_dec(csubstr s, I *__restrict__ v)
{
    static_assert(std::is_integral<I>::value);
    *v = 0;
    for(char c : s)
    {
        if(__builtin_expect(c < '0' || c > '9', 0))
            return false;
        *v = (*v) * I(10) + (I(c) - I('0'));
    }
    return true;
}







template<class I>
inline __attribute__((always_inline)) bool read_hex(csubstr s, I *__restrict__ v)
{
    static_assert(std::is_integral<I>::value);
    *v = 0;
    for(char c : s)
    {
        I cv;
        if(c >= '0' && c <= '9')
            cv = I(c) - I('0');
        else if(c >= 'a' && c <= 'f')
            cv = I(10) + (I(c) - I('a'));
        else if(c >= 'A' && c <= 'F')
            cv = I(10) + (I(c) - I('A'));
        else
            return false;
        *v = (*v) * I(16) + cv;
    }
    return true;
}







template<class I>
inline __attribute__((always_inline)) bool read_bin(csubstr s, I *__restrict__ v)
{
    static_assert(std::is_integral<I>::value);
    *v = 0;
    for(char c : s)
    {
        *v <<= 1;
        if(c == '1')
            *v |= 1;
        else if(c != '0')
            return false;
    }
    return true;
}







template<class I>
inline __attribute__((always_inline)) bool read_oct(csubstr s, I *__restrict__ v)
{
    static_assert(std::is_integral<I>::value);
    *v = 0;
    for(char c : s)
    {
        if(__builtin_expect(c < '0' || c > '7', 0))
            return false;
        *v = (*v) * I(8) + (I(c) - I('0'));
    }
    return true;
}






