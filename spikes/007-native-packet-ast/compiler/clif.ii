void clif_parse_skill_toid( map_session_data* sd, uint16 skill_id, uint16 skill_lv, int32 target_id ){
 if( sd == nullptr ){
  return;
 }

 t_tick tick = gettick();

 if( skill_lv < 1 ) skill_lv = 1;

 int32 inf = skill_get_inf(skill_id);
 if (inf&INF_GROUND_SKILL || !inf)
  return;

 if (sd->state.block_action & PCBLOCK_SKILL) {
  clif_msg( *sd, MSI_BUSY );
  return;
 }

 if( ( (skill_id) >= 8001 && (skill_id) < 8001 +59 ) ) {
  clif_parse_UseSkillToId_homun(sd->hd, sd, tick, skill_id, skill_lv, target_id);
  return;
 }

 if( ( (skill_id) >= 8201 && (skill_id) < 8201 +41 ) ) {
  clif_parse_UseSkillToId_mercenary(sd->md, sd, tick, skill_id, skill_lv, target_id);
  return;
 }



 if (battle_config.idletime_option&IDLE_USESKILLTOID)
  sd->idletime = last_tick;
 if (battle_config.hom_idle_no_share && sd->hd && battle_config.idletime_hom_option&IDLE_USESKILLTOID)
  sd->idletime_hom = last_tick;
 if (battle_config.mer_idle_no_share && sd->md && battle_config.idletime_mer_option&IDLE_USESKILLTOID)
  sd->idletime_mer = last_tick;

 if( sd->npc_id ){
  if( pc_hasprogress( sd, WIP_DISABLE_SKILLITEM ) || !sd->npc_item_flag || !( inf & INF_SELF_SKILL ) ){



   return;
  }
 }

 if ((pc_cant_act2(sd) || sd->chatID) &&
  skill_id != RK_REFRESH &&
  !( ( skill_id == SR_GENTLETOUCH_CURE || skill_id == SU_GROOMING ) && (sd->sc.opt1 == OPT1_STONE || sd->sc.opt1 == OPT1_FREEZE || sd->sc.opt1 == OPT1_STUN)) &&
  !(sd->state.storage_flag && (inf&INF_SELF_SKILL)))
  return;

 if( ( (sd)->vd.dead_sit == 2 ) )
  return;

 if( skill_isNotOk(skill_id, *sd) )
  return;

 if( sd->id != target_id && inf&INF_SELF_SKILL )
  target_id = sd->id;

 if( target_id < 0 && -target_id == sd->id )
  target_id = sd->id;

 if( sd->ud.skilltimer != -1 ) {
  if( skill_id != SA_CASTCANCEL && skill_id != SO_SPELLFIST )
   return;
 } else if( tick_diff(tick,sd->ud.canact_tick) < 0 ) {
  if( sd->skillitem != skill_id ) {
   clif_skill_fail( *sd, skill_id, USESKILL_FAIL_SKILLINTERVAL );
   return;
  }
 }

 if( sd->sc.option&OPTION_COSTUME )
  return;


 if( sd->sc.getSCE(SC_BASILICA) && (skill_id != HP_BASILICA || sd->sc.getSCE(SC_BASILICA)->val4 != sd->id) )
  return;


 if( sd->menuskill_id ) {
  if( sd->menuskill_id == SA_TAMINGMONSTER ) {
   (sd)->menuskill_id = (sd)->menuskill_val = (sd)->menuskill_val2 = 0;;
  }else if( sd->menuskill_id == SG_FEEL ){
   (sd)->menuskill_id = (sd)->menuskill_val = (sd)->menuskill_val2 = 0;;
  }else if( sd->menuskill_id != SA_AUTOSPELL )
   return;
 }

 if( sd->skillitem == skill_id ) {
  if( skill_lv != sd->skillitemlv )
   skill_lv = sd->skillitemlv;
  if( !(inf&INF_SELF_SKILL) )
   pc_delinvincibletimer(sd);
  unit_skilluse_id(sd, target_id, skill_id, skill_lv);
  return;
 }
 sd->skillitem = sd->skillitemlv = 0;

 if( ( (skill_id) >= GD_SKILLBASE && (skill_id) < GD_SKILLBASE+15 ) ) {
  if (sd->guild != nullptr && (sd->state.gmaster_flag || skill_id == GD_CHARGESHOUT_BEATING))
   skill_lv = guild_checkskill(sd->guild->guild, skill_id);
  else
   skill_lv = 0;
 } else {
  if( skill_id != ALL_EQSWITCH ){
   skill_lv = min(pc_checkskill(sd, skill_id),skill_lv);
  }
 }

 pc_delinvincibletimer(sd);

 if( skill_lv )
  unit_skilluse_id(sd, target_id, skill_id, skill_lv);
}






void clif_parse_UseSkillToId( int32 fd, map_session_data *sd ){

 struct s_packet_db* info = &packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))];

 clif_parse_skill_toid( sd, (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[1]))), (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[0]))), (*(uint32*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[2]))) );
}




static void clif_parse_UseSkillToPosSub( int32 fd, map_session_data& sd, uint16 skill_lv, uint16 skill_id, int16 x, int16 y, int32 skillmoreinfo ){
 t_tick tick = gettick();

 if( !(skill_get_inf(skill_id)&INF_GROUND_SKILL) )
  return;

 if (sd.state.block_action & PCBLOCK_SKILL) {
  clif_msg( sd, MSI_BUSY );
  return;
 }

 if( ( (skill_id) >= 8001 && (skill_id) < 8001 +59 ) ) {
  clif_parse_UseSkillToPos_homun(sd.hd, &sd, tick, skill_id, skill_lv, x, y, skillmoreinfo);
  return;
 }

 if( ( (skill_id) >= 8201 && (skill_id) < 8201 +41 ) ) {
  clif_parse_UseSkillToPos_mercenary(sd.md, &sd, tick, skill_id, skill_lv, x, y, skillmoreinfo);
  return;
 }

 if( pc_hasprogress( &sd, WIP_DISABLE_SKILLITEM ) ){



  return;
 }


 if (battle_config.idletime_option&IDLE_USESKILLTOPOS)
  sd.idletime = last_tick;
 if (battle_config.hom_idle_no_share && sd.hd && battle_config.idletime_hom_option&IDLE_USESKILLTOPOS)
  sd.idletime_hom = last_tick;
 if (battle_config.mer_idle_no_share && sd.md && battle_config.idletime_mer_option&IDLE_USESKILLTOPOS)
  sd.idletime_mer = last_tick;

 if( skill_isNotOk(skill_id, sd) )
  return;
 if( skillmoreinfo != -1 ) {
  if( ( (&sd)->vd.dead_sit == 2 ) ) {
   clif_skill_fail( sd, skill_id );
   return;
  }

  safestrncpy(sd.message, ((char*)(session[fd]->rdata + session[fd]->rdata_pos + (skillmoreinfo))), (79 + 1));
 }

 if( sd.ud.skilltimer != -1 )
  return;

 if( tick_diff(tick,sd.ud.canact_tick) < 0 ) {
  if( sd.skillitem != skill_id ) {
   clif_skill_fail( sd, skill_id, USESKILL_FAIL_SKILLINTERVAL );
   return;
  }
 }

 if( sd.sc.option&OPTION_COSTUME )
  return;


 if( sd.sc.getSCE(SC_BASILICA) && (skill_id != HP_BASILICA || sd.sc.getSCE(SC_BASILICA)->val4 != sd.id) )
  return;


 if( sd.menuskill_id ) {
  if( sd.menuskill_id == SA_TAMINGMONSTER ) {
   (&sd)->menuskill_id = (&sd)->menuskill_val = (&sd)->menuskill_val2 = 0;;
  }else if( sd.menuskill_id == SG_FEEL ){
   (&sd)->menuskill_id = (&sd)->menuskill_val = (&sd)->menuskill_val2 = 0;;
  } else if( sd.menuskill_id != SA_AUTOSPELL )
   return;
 }

 pc_delinvincibletimer(&sd);

 if( sd.skillitem == skill_id ) {
  if( skill_lv != sd.skillitemlv )
   skill_lv = sd.skillitemlv;
  unit_skilluse_pos(&sd, x, y, skill_id, skill_lv);
 } else {
  int32 lv;
  sd.skillitem = sd.skillitemlv = 0;
  if( (lv = pc_checkskill(&sd, skill_id)) > 0 ) {
   if( skill_lv > lv )
    skill_lv = lv;
   unit_skilluse_pos(&sd, x, y, skill_id,skill_lv);
  }
 }
}







void clif_parse_UseSkillToPos(int32 fd, map_session_data *sd)
{
 if( sd == nullptr ){
  return;
 }


 struct s_packet_db* info = &packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))];
 if (pc_cant_act(sd))
  return;
 if (( (sd)->vd.dead_sit == 2 ))
  return;

 clif_parse_UseSkillToPosSub(fd, *sd,
  (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[0]))),
  (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[1]))),
  (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[2]))),
  (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[3]))),


  -1
 );
}






void clif_parse_UseSkillToPosMoreInfo(int32 fd, map_session_data *sd)
{
 if( sd == nullptr ){
  return;
 }


 struct s_packet_db* info = &packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))];
 if (pc_cant_act(sd))
  return;
 if (( (sd)->vd.dead_sit == 2 ))
  return;

 clif_parse_UseSkillToPosSub(fd, *sd,
  (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[0]))),
  (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[1]))),
  (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[2]))),
  (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[3]))),
  info->pos[4]
 );
}




void clif_parse_UseSkillMap(int32 fd, map_session_data* sd)
{
 if( sd == nullptr ){
  return;
 }

 sd->state.workinprogress = WIP_DISABLE_NONE;

 const PACKET_CZ_SELECT_WARPPOINT* p = reinterpret_cast<PACKET_CZ_SELECT_WARPPOINT*>( (session[fd]->rdata + session[fd]->rdata_pos + (0)) );

 if( p->skill_id != sd->menuskill_id ){
  return;
 }


 if( pc_cant_act( sd ) && !sd->state.storage_flag && p->skill_id != AL_TELEPORT ){
  (sd)->menuskill_id = (sd)->menuskill_val = (sd)->menuskill_val2 = 0;;
  return;
 }

 pc_delinvincibletimer(sd);

 char map_name[(11 + 1)];

 mapindex_getmapname( p->mapname, map_name );

 skill_castend_map( sd, p->skill_id, map_name );
}




