void clif_parse_BankOpen(int32 fd, map_session_data* sd) {

 const PACKET_CZ_REQ_OPEN_BANKING* p = reinterpret_cast<PACKET_CZ_REQ_OPEN_BANKING*>( (session[fd]->rdata + session[fd]->rdata_pos + (0)) );



 (void)(sd);
 if( !battle_config.feature_banking ) {
  clif_messagecolor_target(sd, color_table[COLOR_RED], map_msg_txt(sd,1496), false, SELF, nullptr);
  return;
 }
 if( map_getmapflag_sub(sd->m, MF_NOBANK, nullptr) ){
  clif_displaymessage( sd->fd, map_msg_txt(sd,831) );
  return;
 }
 else {
  if(sd->status.account_id == p->AID){
   sd->state.banking = 1;



   clif_bank_open( *sd );
  }
 }

}


