template<class Writer>
void Emitter<Writer>::_write_json(NodeScalar const& __restrict__ sc, NodeType flags)
{
    if(__builtin_expect(! sc.tag.empty(), 0))
        do { const char msg[] = "JSON does not have tags"; if(c4::is_debugger_attached()) { ::debug_break(); }; (m_tree->callbacks()).m_error(msg, sizeof(msg), c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/emit.def.hpp", 0, 578, 0), (m_tree->callbacks()).m_user_data); } while(0);
    if(__builtin_expect(flags.has_anchor(), 0))
        do { const char msg[] = "JSON does not have anchors"; if(c4::is_debugger_attached()) { ::debug_break(); }; (m_tree->callbacks()).m_error(msg, sizeof(msg), c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/emit.def.hpp", 0, 580, 0), (m_tree->callbacks()).m_user_data); } while(0);
    _write_scalar_json(sc.scalar, flags.has_key(), flags.is_quoted());
