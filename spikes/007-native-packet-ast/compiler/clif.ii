void clif_sendegg( map_session_data* sd)
{
 int32 i,n=0,fd;

 (void)(sd);

 fd=sd->fd;
 if (battle_config.pet_no_gvg && map_flag_gvg2(sd->m)) {
  clif_displaymessage(fd, map_msg_txt(sd,666));
  return;
 }
 do{ if( ( fd ) && session[( fd )]->wdata_size + ( ( 100 + 0 ) * 2 + 4 ) > session[( fd )]->max_wdata ){ _realloc_writefifo( ( fd ), ( ( 100 + 0 ) * 2 + 4 ), "/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/src/map/clif.cpp", 8251, __FUNCTION__ ); } }while( false );
 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (0)))=0x1a6;
 for(i=0,n=0;i<( 100 + 0 );i++){
  if(sd->inventory.u.items_inventory[i].nameid == 0 || sd->inventory_data[i] == nullptr ||
     sd->inventory_data[i]->type != IT_PETEGG ||
     sd->inventory.u.items_inventory[i].amount <= 0)
   continue;
  (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (n*2+4)))=client_index(i);
  n++;
 }
 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (2)))=4+n*2;
 WFIFOSET(fd,(*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (2))));

 sd->menuskill_id = SA_TAMINGMONSTER;
 sd->menuskill_val = -1;
}
# 8281 "/nix/store/9fnslka6gqn93qwrwzvj07i929fmhv68-source/src/map/clif.cpp"
void clif_send_petdata( const map_session_data* sd, const pet_data& pd, e_changestate_pet data_type ){
 int32 value;

 switch( data_type ) {
  case CHANGESTATEPET_INIT:
   value = 0;
   break;
  case CHANGESTATEPET_INTIMACY:
   value = pd.pet.intimate;
   break;
  case CHANGESTATEPET_HUNGER:
   value = pd.pet.hungry;
   break;
  case CHANGESTATEPET_ACCESSORY:
   value = pd.vd.look[LOOK_HEAD_BOTTOM];
   break;
  case CHANGESTATEPET_PERFORMANCE: {
   int32 num;


   if (pd.pet.intimate > PET_INTIMATE_LOYAL)
    num = pd.get_pet_db()->s_perfor ? 4 : 3;
   else if (pd.pet.intimate > PET_INTIMATE_CORDIAL)
    num = 2;
   else
    num = 1;

   value = rnd_value(1, num);
   break;
  }
  case CHANGESTATEPET_HAIRSTYLE:
   value = battle_config.pet_hair_style;
   break;
  case CHANGESTATEPET_UPDATE_EGG:
   value = ( pd.pet.intimate == 1 ) ? 0 : 1;
   break;
  default:
   return;
 }

 PACKET_ZC_CHANGESTATE_PET packet{};

 packet.PacketType = HEADER_ZC_CHANGESTATE_PET;
 packet.type = static_cast<decltype(packet.type)>( data_type );
 packet.GID = pd.id;
 packet.data = value;

 if (sd != nullptr)
  clif_send( &packet, sizeof( packet ), sd, SELF );
 else
  clif_send( &packet, sizeof( packet ), &pd, AREA );
}




