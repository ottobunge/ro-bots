    inline __attribute__((always_inline)) int compare(ro_substr const that) const { return this->compare(that.str, that.len); }

    inline __attribute__((always_inline)) bool operator== (std::nullptr_t) const { return str == nullptr || len == 0; }
    inline __attribute__((always_inline)) bool operator!= (std::nullptr_t) const { return str != nullptr || len == 0; }

    inline __attribute__((always_inline)) bool operator== (C const c) const { return this->compare(c) == 0; }
    inline __attribute__((always_inline)) bool operator!= (C const c) const { return this->compare(c) != 0; }
    inline __attribute__((always_inline)) bool operator< (C const c) const { return this->compare(c) < 0; }
    inline __attribute__((always_inline)) bool operator> (C const c) const { return this->compare(c) > 0; }
    inline __attribute__((always_inline)) bool operator<= (C const c) const { return this->compare(c) <= 0; }
    inline __attribute__((always_inline)) bool operator>= (C const c) const { return this->compare(c) >= 0; }

    template<class U> inline __attribute__((always_inline)) bool operator== (basic_substring<U> const that) const { return this->compare(that) == 0; }
    template<class U> inline __attribute__((always_inline)) bool operator!= (basic_substring<U> const that) const { return this->compare(that) != 0; }
    template<class U> inline __attribute__((always_inline)) bool operator< (basic_substring<U> const that) const { return this->compare(that) < 0; }
    template<class U> inline __attribute__((always_inline)) bool operator> (basic_substring<U> const that) const { return this->compare(that) > 0; }
    template<class U> inline __attribute__((always_inline)) bool operator<= (basic_substring<U> const that) const { return this->compare(that) <= 0; }
    template<class U> inline __attribute__((always_inline)) bool operator>= (basic_substring<U> const that) const { return this->compare(that) >= 0; }

    template<size_t N> inline __attribute__((always_inline)) bool operator== (const char (&that)[N]) const { return this->compare(that, N-1) == 0; }
    template<size_t N> inline __attribute__((always_inline)) bool operator!= (const char (&that)[N]) const { return this->compare(that, N-1) != 0; }
    template<size_t N> inline __attribute__((always_inline)) bool operator< (const char (&that)[N]) const { return this->compare(that, N-1) < 0; }
    template<size_t N> inline __attribute__((always_inline)) bool operator> (const char (&that)[N]) const { return this->compare(that, N-1) > 0; }
    template<size_t N> inline __attribute__((always_inline)) bool operator<= (const char (&that)[N]) const { return this->compare(that, N-1) <= 0; }
    template<size_t N> inline __attribute__((always_inline)) bool operator>= (const char (&that)[N]) const { return this->compare(that, N-1) >= 0; }



public:





    inline bool is_sub(ro_substr const that) const
    {
        return that.is_super(*this);
    }


    inline bool is_super(ro_substr const that) const
    {
        if(__builtin_expect(len == 0, 0))
        {
            return that.len == 0 && that.str == str && str != nullptr;
        }
        return that.begin() >= begin() && that.end() <= end();
    }


    inline bool overlaps(ro_substr const that) const
    {

        return (that.end() > begin() && that.begin() < end());
    }

