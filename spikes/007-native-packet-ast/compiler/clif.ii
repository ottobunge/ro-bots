    basic_substring pop_right(C sep=C('/'), bool skip_empty=false) const
    {
        if(__builtin_expect(len > 1, 1))
        {
            auto pos = last_of(sep);
            if(pos != npos)
            {
                if(pos + 1 < len)
                {
                    return sub(pos + 1);
                }
                else
                {
                    if( ! skip_empty)
                    {
                        return sub(pos + 1, 0);
                    }
                    auto ppos = last_not_of(sep);
                    if(ppos == npos)
                    {
                        return sub(0, 0);
                    }

                    auto pos0 = last_of(sep, ppos);
                    if(pos0 == npos)
                    {
                        return sub(0);
                    }
                    ++pos0;
                    return sub(pos0);
                }
            }
            else
            {
                return *this;
            }
        }
        else if(len == 1)
        {
            if(begins_with(sep))
            {
                return sub(0, 0);
            }
            return *this;
        }
        else
        {
            return basic_substring();
        }
    }



