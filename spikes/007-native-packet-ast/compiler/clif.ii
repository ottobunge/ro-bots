void clif_parse_PMIgnore(int32 fd, map_session_data* sd)
{
 char* nick;
 uint8 type;
 int32 i;
 struct s_packet_db* info = &packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))];

 nick = ((char*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[0])));
 nick[(23 + 1)-1] = '\0';
 type = (*(uint8*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[1])));

 if( type == 0 ) {
  if (strcmp(wisp_server_name, nick) == 0) {
   clif_wisexin( *sd, type, 1 );
   return;
  }


  do{ for( (i) = (0); (i) < (20); ++(i) ) if( sd->ignore[i].name[0] == '\0' || strcmp(sd->ignore[i].name, nick) == 0 ) break; }while(0);
  if( i == 20 ) {
   clif_wisexin( *sd, type, 2 );
   return;
  }
  if( sd->ignore[i].name[0] != '\0' ) {
   clif_wisexin( *sd, type, 0 );
   return;
  }


  safestrncpy(sd->ignore[i].name, nick, (23 + 1));
 } else {


  do{ for( (i) = (0); (i) < (20); ++(i) ) if( sd->ignore[i].name[0] == '\0' || strcmp(sd->ignore[i].name, nick) == 0 ) break; }while(0);
  if( i == 20 || sd->ignore[i].name[0] == '\0' ) {
   clif_wisexin( *sd, type, 1 );
   return;
  }

  memmove(sd->ignore[i].name, sd->ignore[i+1].name, (20 -i-1)*sizeof(sd->ignore[0].name));

  memset(sd->ignore[20 -1].name, 0, sizeof(sd->ignore[0].name));
 }

 clif_wisexin( *sd, type, 0 );
}
# 15190 "/nix/store/9fnslka6gqn93qwrwzvj07i929fmhv68-source/src/map/clif.cpp"
void clif_parse_PMIgnoreAll( int32 fd, map_session_data* sd ){
 const PACKET_CZ_SETTING_WHISPER_STATE* p = reinterpret_cast<PACKET_CZ_SETTING_WHISPER_STATE*>( (session[fd]->rdata + session[fd]->rdata_pos + (0)) );
 bool failure;

 if( p->type == 0 ) {
  if( sd->state.ignoreAll ) {
   failure = true;
  } else {
   sd->state.ignoreAll = 1;
   failure = false;
  }
 } else {
  if( sd->state.ignoreAll ) {
   sd->state.ignoreAll = 0;
   failure = false;
  } else {
   if (sd->ignore[0].name[0] != '\0')
   {
    memset(sd->ignore, 0, sizeof(sd->ignore));
    failure = false;
   } else {
    failure = true;
   }
  }
 }

 clif_wisall( *sd, p->type, failure );
}




void clif_PMIgnoreList( map_session_data& sd ){
 PACKET_ZC_WHISPER_LIST* p = reinterpret_cast<PACKET_ZC_WHISPER_LIST*>( packet_buffer );

 p->packetType = HEADER_ZC_WHISPER_LIST;
 p->packetSize = sizeof( *p );

 for( size_t i = 0; i < ( sizeof(sd.ignore)/sizeof((sd.ignore)[0]) ) && sd.ignore[i].name[0]; i++ ){
  PACKET_ZC_WHISPER_LIST_sub& entry = p->names[i];

  safestrncpy( entry.name, sd.ignore[i].name, sizeof( entry.name ) );

  p->packetSize += static_cast<decltype(p->packetSize)>( sizeof( entry ) );
 }

 clif_send( p, p->packetSize, &sd, SELF );
}




void clif_parse_PMIgnoreList(int32 fd,map_session_data *sd)
{
 if( sd == nullptr ){
  return;
 }

 clif_PMIgnoreList( *sd );
}




void clif_parse_NoviceDoriDori(int32 fd, map_session_data *sd)
{
 if (sd->state.doridori) return;

 switch (sd->class_&0xfff) {
  case MAPID_SOUL_LINKER:
  case MAPID_STAR_GLADIATOR:
  case MAPID_TAEKWON:
   if (!sd->state.rest)
    break;
   [[fallthrough]];
  case MAPID_SUPER_NOVICE:
  case MAPID_SUPER_BABY:
  case MAPID_SUPER_NOVICE_E:
  case MAPID_SUPER_BABY_E:
   sd->state.doridori=1;
   break;
 }
}
