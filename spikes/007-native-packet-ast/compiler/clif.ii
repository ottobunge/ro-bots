        RSEQIMAP = 0x01 << 13,
    } State_e;

    struct LineContents
    {
        csubstr full;
        csubstr stripped;
        csubstr rem;
        size_t indentation;

        LineContents() : full(), stripped(), rem(), indentation() {}

        void reset_with_next_line(csubstr buf, size_t pos);

        void reset(csubstr full_, csubstr stripped_)
        {
            full = full_;
            stripped = stripped_;
            rem = stripped_;

            indentation = full.first_not_of(' ');
        }

        size_t current_col() const
        {
            return current_col(rem);
        }

        size_t current_col(csubstr s) const
        {
            do { if(!(s.str >= full.str)) { if(c4::is_debugger_attached()) { ::debug_break(); }; c4::yml::error("check failed: " "s.str >= full.str", c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/parse.hpp", 425, 0)); } } while(0);
