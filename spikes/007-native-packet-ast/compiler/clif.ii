void clif_disp_overhead_( const block_list* bl, const char* mes, enum send_target flag)
{
 unsigned char buf[256];
 int16 len_mes;

 len_mes = static_cast<decltype(len_mes)>( strlen(mes) + 1 );

 if (len_mes > sizeof(buf)-8) {
  ShowError("clif_disp_overhead: Message too long (length %d)\n", len_mes);
  len_mes = sizeof(buf)-8;
 }

 if (flag == AREA) {
  (*(uint16*)(((uint8*)((buf))) + ((0)))) = 0x8d;
  (*(uint16*)(((uint8*)((buf))) + ((2)))) = len_mes + 8;
  (*(uint32*)(((uint8*)((buf))) + ((4)))) = bl->id;
  safestrncpy(((char*)(((uint8*)((buf))) + ((8)))), mes, len_mes);
  clif_send(buf, (*(uint16*)(((uint8*)((buf))) + ((2)))), bl, AREA_CHAT_WOC);
 }


 if( bl->type == BL_PC ) {
  (*(uint16*)(((uint8*)((buf))) + ((0)))) = 0x8e;
  (*(uint16*)(((uint8*)((buf))) + ((2)))) = len_mes + 4;
  safestrncpy(((char*)(((uint8*)((buf))) + ((4)))), mes, len_mes);
  clif_send(buf, (*(uint16*)(((uint8*)((buf))) + ((2)))), bl, SELF);
 }
}





