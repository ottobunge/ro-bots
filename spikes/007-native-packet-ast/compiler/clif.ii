struct block_list;



struct s_battleground_member_data {
 uint16 x, y;
 map_session_data *sd;
 unsigned afk : 1;
 struct point entry_point;
};

struct s_battleground_data {
 int32 id;
 std::vector<s_battleground_member_data> members;
 struct point cemetery;
 std::string logout_event;
 std::string die_event;
 std::string active_event;
};

struct s_battleground_team {
 uint16 warp_x, warp_y;
 std::string quit_event,
  death_event,
  active_event,
  bg_id_var;
};

struct s_battleground_map {
 int32 id;
 uint16 mapindex;
 s_battleground_team team1, team2;
 std::string bgcallscript;
 bool isReserved;
};


enum e_queue_state : uint16 {
 QUEUE_STATE_SETUP = 0,
 QUEUE_STATE_SETUP_DELAY,
 QUEUE_STATE_ACTIVE,
 QUEUE_STATE_ENDED,
};


struct s_battleground_queue {
 int32 queue_id;
 int32 id;
 std::vector<map_session_data *> teama_members;
 std::vector<map_session_data *> teamb_members;
 int32 required_players;
 int32 max_players;
 int32 accepted_players;
 e_queue_state state;
 int32 tid_expire;
 int32 tid_start;
 int32 tid_requeue;
 s_battleground_map *map;
};

struct s_battleground_type {
 int32 id;
 std::string name;
 int32 required_players;
 int32 max_players;
 int32 min_lvl;
 int32 max_lvl;
 std::vector<s_battleground_map> maps;
 uint32 deserter_time;
 uint32 start_delay;
 bool solo;
 bool party;
 bool guild;
 std::vector<int32> job_restrictions;
};


enum e_bg_queue_apply_ack : uint16 {
 BG_APPLY_NONE = 0,
 BG_APPLY_ACCEPT,
 BG_APPLY_QUEUE_FINISHED,
 BG_APPLY_INVALID_NAME,
 BG_APPLY_INVALID_APP,
 BG_APPLY_PLAYER_COUNT,
 BG_APPLY_PLAYER_LEVEL,
 BG_APPLY_DUPLICATE,
 BG_APPLY_RECONNECT,
 BG_APPLY_PARTYGUILD_LEADER,
 BG_APPLY_PLAYER_CLASS,
};


enum e_bg_info : uint16 {
 BG_INFO_ID = 0,
 BG_INFO_REQUIRED_PLAYERS,
 BG_INFO_MAX_PLAYERS,
 BG_INFO_MIN_LEVEL,
 BG_INFO_MAX_LEVEL,
 BG_INFO_MAPS,
 BG_INFO_DESERTER_TIME,
};

class BattlegroundDatabase : public TypesafeYamlDatabase<uint32, s_battleground_type> {
public:
 BattlegroundDatabase() : TypesafeYamlDatabase("BATTLEGROUND_DB", 1) {

 }

 const std::string getDefaultLocation() override;
 uint64 parseBodyNode(const ryml::NodeRef& node) override;
};

