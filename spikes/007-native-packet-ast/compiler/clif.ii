    {
        do { if(!((const char*)&n + sizeof(T) < (const char*)m_stack || &n > m_stack + m_capacity)) { if(c4::is_debugger_attached()) { ::debug_break(); }; c4::yml::error("check failed: " "(const char*)&n + sizeof(T) < (const char*)m_stack || &n > m_stack + m_capacity", c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/detail/stack.hpp", 98, 0)); } } while(0);
        if(m_size == m_capacity)
        {
            size_t cap = m_capacity == 0 ? N : 2 * m_capacity;
            reserve(cap);
        }
        m_stack[m_size] = n;
        ++m_size;
    }

    void push_top()
    {
        do { if(!(m_size > 0)) { if(c4::is_debugger_attached()) { ::debug_break(); }; c4::yml::error("check failed: " "m_size > 0", c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/detail/stack.hpp", 110, 0)); } } while(0);
        if(m_size == m_capacity)
        {
            size_t cap = m_capacity == 0 ? N : 2 * m_capacity;
            reserve(cap);
        }
        m_stack[m_size] = m_stack[m_size - 1];
        ++m_size;
    }

    T const& __restrict__ pop()
    {
        do { if(!(m_size > 0)) { if(c4::is_debugger_attached()) { ::debug_break(); }; c4::yml::error("check failed: " "m_size > 0", c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/detail/stack.hpp", 122, 0)); } } while(0);
        --m_size;
        return m_stack[m_size];
    }

    inline __attribute__((always_inline)) T const& __restrict__ top() const { do { if(!(m_size > 0)) { if(c4::is_debugger_attached()) { ::debug_break(); }; c4::yml::error("check failed: " "m_size > 0", c4::yml::Location("/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/3rdparty/rapidyaml/src/c4/yml/detail/stack.hpp", 127, 0)); } } while(0); return m_stack[m_size - 1]; }
