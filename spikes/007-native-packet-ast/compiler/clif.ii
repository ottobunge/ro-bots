    bool next_split(C sep, size_t *__restrict__ start_pos, basic_substring *__restrict__ out) const
    {
        if(__builtin_expect(*start_pos < len, 1))
        {
            for(size_t i = *start_pos, e = len; i < e; i++)
            {
                if(str[i] == sep)
                {
                    out->assign(str + *start_pos, i - *start_pos);
                    *start_pos = i+1;
                    return true;
                }
            }
            out->assign(str + *start_pos, len - *start_pos);
            *start_pos = len + 1;
            return true;
        }
        else
        {
            bool valid = len > 0 && (*start_pos == len);
            if(valid && !empty() && str[len-1] == sep)
            {
                out->assign(str + len, (size_t)0);
            }
            else
            {
                out->assign(str + len + 1, (size_t)0);
            }
            *start_pos = len + 1;
            return valid;
        }
    }

