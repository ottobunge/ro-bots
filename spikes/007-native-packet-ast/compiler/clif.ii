# 14214 "/nix/store/9fnslka6gqn93qwrwzvj07i929fmhv68-source/src/map/clif.cpp"
void clif_parse_OpenVending(int32 fd, map_session_data* sd){
 if( sd == nullptr ){
  return;
 }

 int32 cmd = (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)));
 struct s_packet_db* info = &packet_db[cmd];
 int16 len = (int16)(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[0])));
 const char* message = ((char*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[1])));
 const uint8* data = (uint8*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[3]));

 if(cmd == 0x12f){
  len -= 84;
 }
 else {
  bool flag;

  len -= 85;
  flag = (*(uint8*)(session[fd]->rdata + session[fd]->rdata_pos + (info->pos[2]))) != 0;
  if (!flag) {
   sd->state.prevend = 0;
   sd->state.workinprogress = WIP_DISABLE_NONE;
  }
 }

 if( sd->sc.getSCE(SC_NOCHAT) && sd->sc.getSCE(SC_NOCHAT)->val1&MANNER_NOROOM )
  return;
 if( map_getmapflag_sub(sd->m, MF_NOVENDING, nullptr) ) {
  clif_displaymessage (sd->fd, map_msg_txt(sd,276));
  return;
 }
 if( map_getcell(sd->m,sd->x,sd->y,CELL_CHKNOVENDING) ) {
  clif_displaymessage (sd->fd, map_msg_txt(sd,204));
  return;
 }

 if( message[0] == '\0' )
  return;

 vending_openvending(*sd, message, data, len/8, nullptr);
}




