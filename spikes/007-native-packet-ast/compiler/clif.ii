void clif_parse_GMKick(int32 fd, map_session_data *sd)
{
 block_list *target;
 int32 tid;

 tid = (*(uint32*)(session[fd]->rdata + session[fd]->rdata_pos + (packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))].pos[0])));
 target = map_id2bl(tid);
 if (!target) {
  clif_GM_kickack(sd, 0);
  return;
 }

 switch (target->type) {
  case BL_PC:
  {
   char command[(23 + 1)+6];
   safesnprintf(command,sizeof(command),"%ckick %s", atcommand_symbol, status_get_name(*target));
   is_atcommand(fd, sd, command, 1);
  }
  break;




  case BL_MOB:
  {
   char command[100];
   if( !pc_can_use_command(sd, "killmonster", COMMAND_ATCOMMAND)) {
    clif_GM_kickack(sd, 0);
    return;
   }
   safesnprintf(command,sizeof(command),"/kick %s (%d)", status_get_name(*target), status_get_class(target));
   log_atcommand(sd, command);
   status_percent_damage(sd, target, 100, 0, true);
  }
  break;

  case BL_NPC:
  {
   npc_data* nd = (npc_data *)target;
   if( pc_can_use_command(sd, "unloadnpc", COMMAND_ATCOMMAND)) {
    npc_unload_duplicates(nd);
    npc_unload(nd,true);
    npc_read_event_script();
   }
  }
  break;

  default:
   clif_GM_kickack(sd, 0);
 }
}





