static inline int32 itemtype(t_itemid nameid) {
 struct item_data* id = itemdb_search(nameid);
 int32 type = id->type;
 if( type == IT_SHADOWGEAR ) {
  if( id->equip&EQP_SHADOW_WEAPON )
   return IT_WEAPON;
  else
   return IT_ARMOR;
 }
 return ( type == IT_PETEGG ) ? IT_ARMOR : type;
}


