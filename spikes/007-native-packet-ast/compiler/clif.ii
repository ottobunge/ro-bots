int32 clif_setip(const char* ip) {
 char ip_str[16];
 map_ip = host2ip(ip);
 if (!map_ip) {
  ShowWarning("Failed to Resolve Map Server Address! (%s)\n", ip);
  return 0;
 }

 safestrncpy(map_ip_str, ip, sizeof(map_ip_str));
 ShowInfo("Map Server IP Address : '" "\033[1;37m" "%s" "\033[0m" "' -> '" "\033[1;37m" "%s" "\033[0m" "'.\n", ip, ip2str(map_ip, ip_str));
 return 1;
}

void clif_setbindip(const char* ip)
{
 bind_ip = host2ip(ip);
 if (bind_ip) {
  char ip_str[16];
  ShowInfo("Map Server Bind IP Address : '" "\033[1;37m" "%s" "\033[0m" "' -> '" "\033[1;37m" "%s" "\033[0m" "'.\n", ip, ip2str(bind_ip, ip_str));
 } else {
  ShowWarning("Failed to Resolve Map Server Address! (%s)\n", ip);
 }
}





void clif_setport(uint16 port)
{
 map_port = port;
}




uint32 clif_getip(void)
{
 return map_ip;
}


uint32 clif_refresh_ip(void)
{
 uint32 new_ip;

 new_ip = host2ip(map_ip_str);
 if (new_ip && new_ip != map_ip) {
  map_ip = new_ip;
  ShowInfo("Updating IP resolution of [%s].\n", map_ip_str);
  return map_ip;
 }
 return 0;
}




uint16 clif_getport(void)
{
 return map_port;
}


static inline unsigned char clif_bl_type(const block_list* bl, bool walking) {
 switch (bl->type) {
 case BL_PC: return (disguised(bl) && !( ( ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) < JOB_MAX_BASIC ) || ( ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) >= JOB_NOVICE_HIGH && ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) <= JOB_DARK_COLLECTOR ) || ( ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) >= JOB_RUNE_KNIGHT && ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) <= JOB_MECHANIC_T2 ) || ( ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) >= JOB_BABY_RUNE_KNIGHT && ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) <= JOB_BABY_MECHANIC2 ) || ( ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) >= JOB_SUPER_NOVICE_E && ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) <= JOB_SUPER_BABY_E ) || ( ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) >= JOB_KAGEROU && ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) <= JOB_OBORO ) || ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) == JOB_REBELLION || ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) == JOB_SUMMONER || ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) == JOB_BABY_SUMMONER || ( ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) >= JOB_BABY_NINJA && ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) <= JOB_BABY_REBELLION ) || ( ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) >= JOB_BABY_STAR_GLADIATOR2 && ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) <= JOB_BABY_STAR_EMPEROR2 ) || ( ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) >= JOB_DRAGON_KNIGHT && ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) <= JOB_TROUVERE ) || ( ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) >= JOB_WINDHAWK2 && ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) <= JOB_IMPERIAL_GUARD2 ) || ( ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) >= JOB_SKY_EMPEROR && ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) <= JOB_SPIRIT_HANDLER ) || ((uint32)status_get_viewdata(bl)->look[LOOK_BASE]) == JOB_SKY_EMPEROR2 ))? 0x1:0x0;
 case BL_ITEM: return 0x2;
 case BL_SKILL: return 0x3;
 case BL_CHAT: return 0x4;
 case BL_MOB:
