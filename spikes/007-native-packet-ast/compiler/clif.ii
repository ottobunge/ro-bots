 if (( (sd)->npc_id || (sd)->state.vending || (sd)->state.buyingstore || (sd)->state.trading ) || !( (sd)->sc.getSCE(SC_PUSH_CART) ) || pc_cant_act2(sd))
  return;
 if (map_getmapflag_sub(sd->m, MF_NOUSECART, nullptr))
