void clif_class_change( const block_list& bl, int32 class_, enum send_target target, const map_session_data* sd ){
 if( ( ( ((uint32)class_) < JOB_MAX_BASIC ) || ( ((uint32)class_) >= JOB_NOVICE_HIGH && ((uint32)class_) <= JOB_DARK_COLLECTOR ) || ( ((uint32)class_) >= JOB_RUNE_KNIGHT && ((uint32)class_) <= JOB_MECHANIC_T2 ) || ( ((uint32)class_) >= JOB_BABY_RUNE_KNIGHT && ((uint32)class_) <= JOB_BABY_MECHANIC2 ) || ( ((uint32)class_) >= JOB_SUPER_NOVICE_E && ((uint32)class_) <= JOB_SUPER_BABY_E ) || ( ((uint32)class_) >= JOB_KAGEROU && ((uint32)class_) <= JOB_OBORO ) || ((uint32)class_) == JOB_REBELLION || ((uint32)class_) == JOB_SUMMONER || ((uint32)class_) == JOB_BABY_SUMMONER || ( ((uint32)class_) >= JOB_BABY_NINJA && ((uint32)class_) <= JOB_BABY_REBELLION ) || ( ((uint32)class_) >= JOB_BABY_STAR_GLADIATOR2 && ((uint32)class_) <= JOB_BABY_STAR_EMPEROR2 ) || ( ((uint32)class_) >= JOB_DRAGON_KNIGHT && ((uint32)class_) <= JOB_TROUVERE ) || ( ((uint32)class_) >= JOB_WINDHAWK2 && ((uint32)class_) <= JOB_IMPERIAL_GUARD2 ) || ( ((uint32)class_) >= JOB_SKY_EMPEROR && ((uint32)class_) <= JOB_SPIRIT_HANDLER ) || ((uint32)class_) == JOB_SKY_EMPEROR2 ) ){

  return;
 }

 PACKET_ZC_NPCSPRITE_CHANGE p = {};

 p.packetType = HEADER_ZC_NPCSPRITE_CHANGE;
 p.GID = bl.id;

 p.type = 0;
 p.class_ = class_;

