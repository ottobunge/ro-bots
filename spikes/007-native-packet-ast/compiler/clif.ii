  return;
 if( mail_id <= 0 )
  return;
 if( mail_invalid_operation(sd) )
  return;

 do{ for( (i) = (0); (i) < (30); ++(i) ) if( sd->mail.inbox.msg[i].id == mail_id ) break; }while(0);
 if( i == 30 )
  return;

 msg = &sd->mail.inbox.msg[i];

 if( attachment&MAIL_ATT_ZENY && msg->zeny < 1 ){
  attachment &= ~MAIL_ATT_ZENY;
 }

 if( attachment&MAIL_ATT_ITEM ){
  do{ for( (i) = (0); (i) < (5); ++(i) ) if( msg->item[i].nameid > 0 || msg->item[i].amount > 0 ) break; }while(0);


  if( i == 5 ){
