void clif_npc_buy_result( map_session_data* sd, e_purchase_result result ){
 PACKET_ZC_PC_PURCHASE_RESULT p = {};

 p.packetType = HEADER_ZC_PC_PURCHASE_RESULT;
 p.result = (uint8)result;

