void clif_parse_Auction_bid( int32 fd, map_session_data* sd ){

 const PACKET_CZ_AUCTION_BUY* p = reinterpret_cast<PACKET_CZ_AUCTION_BUY*>( (session[fd]->rdata + session[fd]->rdata_pos + (0)) );

