void clif_use_card( const map_session_data* sd,int32 idx)
{
 int32 i,c,ep;
 int32 fd=sd->fd;

 (void)(sd);
 if (idx < 0 || idx >= ( 100 + 0 ))
  return;

 if (!sd->inventory_data[idx] || sd->inventory_data[idx]->type != IT_CARD)
  return;

 ep=sd->inventory_data[idx]->equip;
 do{ if( ( fd ) && session[( fd )]->wdata_size + ( ( 100 + 0 ) * 2 + 4 ) > session[( fd )]->max_wdata ){ _realloc_writefifo( ( fd ), ( ( 100 + 0 ) * 2 + 4 ), "/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/src/map/clif.cpp", 7087, __FUNCTION__ ); } }while( false );
 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (0)))=0x17b;

 for(i=c=0;i<( 100 + 0 );i++){
  int32 j;

  if(sd->inventory_data[i] == nullptr)
   continue;
  if(sd->inventory_data[i]->type!=IT_WEAPON && sd->inventory_data[i]->type!=IT_ARMOR)
   continue;
  if((sd->inventory.u.items_inventory[i].card[0] == CARD0_FORGE || sd->inventory.u.items_inventory[i].card[0] == CARD0_CREATE || sd->inventory.u.items_inventory[i].card[0] == CARD0_PET))
   continue;

  if(sd->inventory.u.items_inventory[i].identify==0 )
   continue;

  if((sd->inventory_data[i]->equip&ep)==0)
   continue;

  if(sd->inventory_data[i]->type==IT_WEAPON && ep==EQP_HAND_L)
   continue;

  if(sd->inventory_data[i]->type == IT_ARMOR && (ep & (EQP_ACC_L|EQP_ACC_R)) && ((ep & (EQP_ACC_L|EQP_ACC_R)) != (EQP_ACC_L|EQP_ACC_R)) && ((sd->inventory_data[i]->equip & (EQP_ACC_L|EQP_ACC_R)) != (ep & (EQP_ACC_L|EQP_ACC_R))) )
   continue;

  do{ for( (j) = (0); (j) < (sd->inventory_data[i]->slots); ++(j) ) if( sd->inventory.u.items_inventory[i].card[j] == 0 ) break; }while(0);
  if( j == sd->inventory_data[i]->slots )
   continue;

  if( sd->inventory.u.items_inventory[i].equip > 0 )
   continue;

  (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (4+c*2)))=i+2;
  c++;
 }

 if( !c ) return;

 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (2)))=4+c*2;
 WFIFOSET(fd,(*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (2))));
}







