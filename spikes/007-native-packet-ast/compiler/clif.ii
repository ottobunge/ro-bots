void do_init_clif(void) {
 const int32 colors[COLOR_MAX] = {
  0x00FF00,
  0xFF0000,
  0xFFFFFF,
  0xFFFF00,
  0x00FFFF,
  0xB5FFB5,
  0xFFFF63,
 };




 for( int32 i = 0; i < COLOR_MAX; i++ ){
  color_table[i] = ( colors[i] & 0x0000FF ) << 16 | ( colors[i] & 0x00FF00 ) | ( colors[i] & 0xFF0000 ) >> 16;
 }

 packetdb_readdb();

 set_defaultparse(clif_parse);
 if( make_listen_bind(bind_ip,map_port) == -1 ) {
  ShowFatalError("Failed to bind to port '" "\033[1;37m" "%d" "\033[0m" "'\n",map_port);
  exit(
