template <typename P>
bool socket_send( int32 fd, P& packet ){
 if( !session_isActive( fd ) ){
  return false;
 }

 do{ if( ( fd ) && session[( fd )]->wdata_size + ( sizeof( P ) ) > session[( fd )]->max_wdata ){ _realloc_writefifo( ( fd ), ( sizeof( P ) ), "/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/src/common/socket.hpp", 212, __FUNCTION__ ); } }while( false );
 memcpy( (session[fd]->wdata + session[fd]->wdata_size + (0)), &packet, sizeof( P ) );
 WFIFOSET( fd, sizeof( P ) );

 return true;
}

template <typename P>
bool socket_send( int32 fd, P* packet ){
 if( !session_isActive( fd ) ){
  return false;
 }

 do{ if( ( fd ) && session[( fd )]->wdata_size + ( packet->packetLength ) > session[( fd )]->max_wdata ){ _realloc_writefifo( ( fd ), ( packet->packetLength ), "/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/src/common/socket.hpp", 225, __FUNCTION__ ); } }while( false );
 memcpy( (session[fd]->wdata + session[fd]->wdata_size + (0)), packet, packet->packetLength );
 WFIFOSET( fd, packet->packetLength );

 return true;
}
