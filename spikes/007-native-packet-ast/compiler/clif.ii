 packet.result = failure;

 clif_send( &packet, sizeof( packet ), &sd, SELF );
}




void clif_item_identify_list( map_session_data *sd)
{
 int32 i,c;
 int32 fd;

 (void)(sd);

 fd=sd->fd;

 do{ if( ( fd ) && session[( fd )]->wdata_size + ( ( 100 + 0 ) * 2 + 4 ) > session[( fd )]->max_wdata ){ _realloc_writefifo( ( fd ), ( ( 100 + 0 ) * 2 + 4 ), "/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/src/map/clif.cpp", 7158, __FUNCTION__ ); } }while( false );
 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (0)))=0x177;
 for(i=c=0;i<( 100 + 0 );i++){
  if(sd->inventory.u.items_inventory[i].nameid > 0 && !sd->inventory.u.items_inventory[i].identify){
   (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (c*2+4)))=client_index(i);
   c++;
  }
 }
 if(c > 0) {
  (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (2)))=c*2+4;
  WFIFOSET(fd,(*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (2))));
  sd->menuskill_id = MC_IDENTIFY;
  sd->menuskill_val = c;
  sd->state.workinprogress = WIP_DISABLE_ALL;
 }
}







