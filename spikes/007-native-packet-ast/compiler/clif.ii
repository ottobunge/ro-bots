void clif_parse_Oneclick_Itemidentify(int32 fd, map_session_data *sd) {

 int16 idx = (*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (packet_db[(*(uint16*)(session[fd]->rdata + session[fd]->rdata_pos + (0)))].pos[0]))) - 2, magnifier_idx;





 if (idx < 0 || idx >= ( 100 + 0 ) ||
  sd->inventory.u.items_inventory[idx].nameid == 0 || sd->inventory_data[idx] == nullptr ||
  sd->inventory.u.items_inventory[idx].identify)
   return;


 if ((magnifier_idx = pc_search_inventory(sd, ITEMID_MAGNIFIER)) == -1 &&
  (magnifier_idx = pc_search_inventory(sd, ITEMID_NOVICE_MAGNIFIER)) == -1)
  return;

 if (pc_delitem(sd, magnifier_idx, 1, 0, 0, LOG_TYPE_OTHER) != 0)
  return;

    skill_identify(sd, idx);

}


void clif_navigateTo( const map_session_data* sd, const char* mapname, uint16 x, uint16 y, uint8 flag, bool hideWindow, uint16 mob_id ){

 int32 fd = sd->fd;

 do{ if( ( fd ) && session[( fd )]->wdata_size + ( 27 ) > session[( fd )]->max_wdata ){ _realloc_writefifo( ( fd ), ( 27 ), "/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/src/map/clif.cpp", 21467, __FUNCTION__ ); } }while( false );
 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (0))) = 0x08e2;


 if( mob_id > 0 ){
  x = 0;
  y = 0;
  (*(uint8*)(session[fd]->wdata + session[fd]->wdata_size + (2))) = 3;
 }else if( x > 0 && y > 0 ){
  (*(uint8*)(session[fd]->wdata + session[fd]->wdata_size + (2))) = 0;
 }else{
  x = 0;
  y = 0;
  (*(uint8*)(session[fd]->wdata + session[fd]->wdata_size + (2))) = 1;
 }


 (*(uint8*)(session[fd]->wdata + session[fd]->wdata_size + (3))) = flag;

 (*(uint8*)(session[fd]->wdata + session[fd]->wdata_size + (4))) = hideWindow;

 safestrncpy( ((char*)(session[fd]->wdata + session[fd]->wdata_size + (5))),mapname,((11 + 1) + 4));

 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (21))) = x;

 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (23))) = y;

 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (25))) = mob_id;
 WFIFOSET(fd,27);

}



void clif_hat_effects( const block_list& bl, enum send_target target, const block_list& tbl ){

 if( map_data* mdata = map_getmapdata( bl.m ); mdata != nullptr && mdata->getMapFlag( MF_NOCOSTUME ) ){
  return;
 }

 const unit_data* ud = unit_bl2ud( &bl );

 if( ud == nullptr ){
  return;
 }

 if( ud->hatEffects.empty() ){
  return;
 }

 PACKET_ZC_EQUIPMENT_EFFECT* p = reinterpret_cast<PACKET_ZC_EQUIPMENT_EFFECT*>( packet_buffer );

 p->packetType = HEADER_ZC_EQUIPMENT_EFFECT;
 p->packetLength = sizeof( *p );
 p->aid = bl.id;
 p->status = 1;

 for( size_t i = 0; i < ud->hatEffects.size(); i++ ){
  p->effects[i] = ud->hatEffects[i];

  p->packetLength += static_cast<decltype(p->packetLength)>( sizeof( p->effects[0] ) );
 }

 clif_send( p, p->packetLength, &tbl, target );

}



void clif_hat_effect_single( const block_list& bl, uint16 effectId, bool enable ){

 if( map_data* mdata = map_getmapdata( bl.m ); mdata != nullptr && mdata->getMapFlag( MF_NOCOSTUME ) ){
  return;
 }

 PACKET_ZC_EQUIPMENT_EFFECT* p = reinterpret_cast<PACKET_ZC_EQUIPMENT_EFFECT*>( packet_buffer );

 p->packetType = HEADER_ZC_EQUIPMENT_EFFECT;
 p->packetLength = sizeof( *p );
 p->aid = bl.id;
 p->status = enable;
 p->effects[0] = effectId;
 p->packetLength += static_cast<decltype(p->packetLength)>( sizeof( p->effects[0] ) );

 clif_send( p, p->packetLength, &bl, AREA );

}




