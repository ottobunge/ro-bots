void clif_storagepassword(map_session_data* sd, int16 info)
{
 int32 fd = sd->fd;

 do{ if( ( fd ) && session[( fd )]->wdata_size + ( packet_db[0x23a].len ) > session[( fd )]->max_wdata ){ _realloc_writefifo( ( fd ), ( packet_db[0x23a].len ), "/nix/store/9FNSLKA6GQN93QWRWZVJ07I929FMHV68-source/src/map/clif.cpp", 13751, __FUNCTION__ ); } }while( false );
 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (0))) = 0x23a;
 (*(uint16*)(session[fd]->wdata + session[fd]->wdata_size + (2))) = info;
 WFIFOSET(fd,packet_db[0x23a].len);
}
