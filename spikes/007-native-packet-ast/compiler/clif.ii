namespace c4 {






namespace detail {

template<typename C>
static inline void _do_reverse(C *__restrict__ first, C *__restrict__ last)
{
    while(last > first)
    {
        C tmp = *last;
        *last-- = *first;
        *first++ = tmp;
    }
}

