    "source_refs": [
      {
        "ref": "src/map/map.cpp:2231-2238; src/map/chrif.cpp:136-165,743-769",
        "finding": "Inactive map_quit deletes the non-logout auth node and returns; the auth timeout only visits remaining nodes, so a 60-second wait is not a guaranteed cure."
      },
      {
        "ref": "src/map/clif.cpp:25684-25705",
        "finding": "Pinned inactive EOF branch uses the Player AID/CID logged-off template, distinguishing the source route without claiming an interserver packet trace."
      },
      {
        "ref": "src/map/map.cpp:2324-2330,5009-5040,5316-5325; src/map/chrif.cpp:1457-1475",
        "finding": "Active map_quit constructs the normal quit save. Map shutdown kicks actual users and finalize attempts map-specific offline reset plus FIFO flush while char remains alive. An orphan absent from map memory is not proven cleared by this alone."
      },
      {
        "ref": "src/char/char_mapif.cpp:903-906; src/char/char.cpp:222-255",
        "finding": "Map-specific reset kicks character-cache entries; known map entries are kicked, not unconditionally SQL-cleared. Character all-offline SQL reset instead updates every row of configured char table and every guild connect_member counter."
      },
      {
        "ref": "src/char/char.cpp:1249-1261,3151-3177,3180-3187,3211-3214",
        "finding": "Character initialize calls inter_init_sql then char_mmo_sql_init -> char_set_all_offline_sql. Normal finalize also calls all-offline SQL and clears char, online and auth caches before SQL free."
      },
      {
        "ref": "src/common/core.cpp:115-126,149-151,379-403,473-476; src/common/core.hpp:95-101",
        "finding": "SIGTERM transitions Core to STOPPING and invokes role shutdown; main loop exits into role finalize. Exact configured Core bytes match the installed source manifest; normal SQL reset is not excluded by the compiled MAIN/pre-re profile."
      },
      {
        "ref": "src/login/login.cpp:804-851; src/login/loginchrif.cpp:866-881,902-915; src/char/char_logif.cpp:870-891",
        "finding": "Login finalize clears in-memory online/auth maps. Normal char disconnection marks its login cache users offline. Restarting the same login process additionally discards lingering login cache state; no nonexistent login.online column is assumed."
      }
    ],
