    "JOURNAL-DIAGNOSTIC-001": {
      "closure": "closed_for_supported_reviewed_public_close_and_constructor_diagnostic_seams",
      "evidence": "Five sole diagnostic cases use actual unpatched normal os.close after actual append/True ack and inject only owned post-close fstat. Four non-Exception objects propagate with origin frames after unresolved/diagnostic_failed snapshot assignment; ordinary EIO returns conservatively. Unpatched EBADF and fresh-process flock prove release independently; repeated close performs no additional diagnostic and ack/write deny. Sixteen close-primary contrasts preserve first OSError/KeyboardInterrupt before/after physical release against four different diagnostic nonlocal origins. Sixteen additional constructors use actual normal cleanup close and preserve their original fstat/pread primary against those four origins.",
      "active_primary_policy": "sys.exception includes active caller except state, not just a close failure. Four fresh normal-close-in-external-except contrasts preserve that caller primary and intentionally suppress the diagnostic. Constructor active-primary contrasts separately pass. Not a claim that every diagnostic raised in every lexical caller context escapes."
    },
    "JOURNAL-OWNERSHIP-002": {
      "closure": "closed_for_explicit_getpid_preallocation_and_reached_allocated_OS_seams",
      "evidence": "Four getpid KeyboardInterrupt/SystemExit cases distinguish a fresh leaf from already-existing history and use a separate positive control. Exact objects/frames survive one PID call; owned writer open/close counts are zero, borrowed root remains valid, no capsule is claimed, no new leaf appears, pre-existing bytes stay unchanged. Forty-two allocated cases record exactly one PID call/open/close attempt at flock/first-file-fstat/pread/malformed replay, with pre-release and release-before-raise cleanup and normal/EIO/SystemExit diagnostics. Original errors expose typed owner-PID snapshots, absent initial identity where appropriate, released_observed/identity_unknown/descriptor_present/diagnostic_failed observations accurately without granting authority.",
      "failure_model": "Explicit called OS seams only. No arbitrary bytecode/dataclass-allocation interruption immunity is asserted; typed snapshot construction is data, not a security capability."
    },
    "JOURNAL-ACK-001": {
      "closure": "closed_for_frozen_acknowledgement_method",
      "evidence": "Twelve fresh root-fstat/file-fstat/entry-stat x KeyboardInterrupt/SystemExit/GeneratorExit/custom BaseException cases start at real append/True ack, poison and propagate exact origin/frame, visit only once, deny later acknowledgements and writes. Ordinary denial regressions in unchanged repository tests also pass."
    },
    "JOURNAL-OWNERSHIP-001": {
      "closure": "partially_addressed_original_unconditional_release_not_closed; narrowed_observational_handoff_contract_verified",
      "evidence": "Public snapshots remain reachable after one attempt and on first allocated constructor failures. Two real same-inode/other-inode descriptor reuse probes remain unresolved and never reclose the replacement; stale active snapshots do not become live authority. Two newly owned workers retain actually live unresolved descriptors and locks until normal exit 0, then the kernel releases them and fresh processes can flock. No manual descriptor close is counted as process recovery.",
      "contract_migration": "An independently owned and separately authorized process boundary makes the retained handoff operationally meaningful. No cleanup for arbitrary long-lived host targets, process kill/recovery/retry action API, or hostile same-UID exclusion is implemented. The original failed zero-live-descriptors oracle/report is unchanged, not rerun, and not claimed to pass."
    }
