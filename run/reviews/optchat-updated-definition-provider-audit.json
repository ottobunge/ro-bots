  "findings": [
    {
      "id": "P1",
      "status": "noncompliant",
      "title": "Dynamic state comes before memory",
      "evidence": [
        "src/robots/domain/decisions.py:53-78",
        "src/robots/app/brain.py:422-425"
      ],
      "detail": "All eight captured adapter routes change before the memory marker. SystemOne JSON field order is observed wire shape, not proof of model-token order; the local server applies a weights-owned systemone Jinja template. Chat content unambiguously has the current human message before the memory."
    },
    {
      "id": "P2",
      "status": "noncompliant",
      "title": "No updated provider cache protocol",
      "evidence": [
        "src/robots/adapters/chat/_http.py:35-44",
        "src/robots/adapters/playing_backends.py:138-147",
        "src/robots/adapters/decision/_http.py:14-28"
      ],
      "detail": "No four-line view blocks, cache_control/end marks, shared-prefix response-start admission or cache-hit accounting. No Anthropic route is present. Absence of Anthropic markers does not imply that local/Workers implicit caching is impossible."
    },
    {
      "id": "P3",
      "status": "noncompliant",
      "title": "Compaction has no contextual view or common UniiChat system/tools",
      "evidence": [
        "src/robots/society/memory.py:99-110",
        "src/robots/society/memory.py:220-247",
        "src/robots/app/agent_runtime.py:1001-1022"
      ],
      "detail": "QwenSummarizer sends bare A/B text, clips to 200 characters, with no 512-byte ruler/retry protocol, readiness queue or concurrency-eight scheduler. Host always constructs StubSummarizer, not Qwen, even when real decision/chat models are injected. Default stub clips to 120 characters."
    },
    {
      "id": "P4",
      "status": "noncompliant",
      "title": "View is recomputed, character-budgeted, and incomplete under pressure",
      "evidence": [
        "src/robots/society/memory.py:260-328",
        "src/robots/domain/decisions.py:77-78"
      ],
      "detail": "The 4000-character budget is not UTF-8 bytes, cover selection is recomputed each view, oldest lines are dropped, optional ages mutate lines, and the decision builder takes only the first 40 lines. Persisted nodes do not persist view state or fix prompt ordering."
    },
    {
      "id": "P5",
      "status": "partial",
      "title": "Raw journal durability and per-persona wiring are real",
      "evidence": [
        "src/robots/adapters/memory_journal.py:75-105",
        "src/robots/adapters/memory_journal.py:137-156",
        "src/robots/society/memory.py:169-174",
        "src/robots/app/agent_runtime.py:973-1022"
      ],
      "detail": "Caller-provided memory_root enables private per-persona raw storage; brain, scheduled agent and inspector share the same owned memory. Raw append flush/fsync precedes visible local history. Offline host identity/isolation and fresh-process raw+node replay passed. No real game clients were started. Default memory_root=None is nondurable."
    },
    {
      "id": "P6",
      "status": "partial",
      "title": "Experiences are not a verbatim never-ending chat transcript",
      "evidence": [
        "src/robots/society/memory.py:28-34",
        "src/robots/society/memory.py:410-414",
        "src/robots/app/brain.py:270-280"
      ],
      "detail": "remember collapses whitespace. Only selected RO experiences are logged, not all decision requests/replies/tool JSON/results/work reports. A received human message is remembered before the decision view, unlike render-before-new-message. Legacy other notes stay other; current ninth kind npc_dialogue is additive, not a transcript migration."
    },
    {
      "id": "P7",
      "status": "partial",
      "title": "Node cache is opt-in and bounded, not whole-chat view persistence",
      "evidence": [
        "src/robots/adapters/memory_summary_cache.py:24-29",
        "src/robots/adapters/memory_summary_cache.py:154-167",
        "src/robots/adapters/memory_summary_cache.py:199-219",
        "src/robots/app/agent_runtime.py:1008-1022"
      ],
      "detail": "Separate source/world/persona/policy-bound nodes restore without re-summarization. Raw journal uses caller-scoped root; cache namespacing does not prevent reuse of the same raw root across worlds. No view.json or persisted batch state. Cache admits at most 8192 nodes; eager full-tree construction requires 8194 nodes at 4098 notes, so this adapter cannot sustain never-ending complete node persistence unchanged."
    },
    {
      "id": "P8",
      "status": "noncompliant",
      "title": "No model-addressable updated zoom/date tools",
      "evidence": [
        "src/robots/society/memory.py:347-372",
        "src/robots/society/memory.py:419-420",
        "src/robots/domain/decisions.py:80-147",
        "src/robots/app/context_selector.py:176-239"
      ],
      "detail": "Legacy Llevel:index zoom expands summaries and level-zero returns unchanged, not the original note; no date(id) tool or typed model zoom/date choice exists in the actual brain. Context selector/bridge is an ancillary relevance-filtered, character-budgeted path, not wired into EventDrivenBrain."
    },
    {
      "id": "P9",
      "status": "unverified",
      "title": "Context capacity and cache economics cannot be established offline",
      "evidence": [
        "scripts/serve-playing-models.sh:15-16",
        "spikes/005-gpu-clef/serve.sh:24-27",
        "spikes/001-clef-local/llama.cpp/tools/server/server-context.cpp:3329-3369",
        "spikes/001-clef-local/llama.cpp/tools/server/server-decision.cpp:399-457"
      ],
      "detail": "Local launcher specifies -c 4096 -np 1; legacy GPU launcher specifies -c 65536 -np 8. These are source launch flags, not measured running slots. Server validates tokenized prompts against per-slot context and question batch constraints. No universal byte/token ratio; 64000/128000-byte serialization is not provider acceptance or token fit. Cloudflare and remote-chat current limits are deliberately unknown; no network lookup/calls/model loads authorized."
    }
  ],
